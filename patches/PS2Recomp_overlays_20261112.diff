+            if ((overlay.rawCodeOffset & 3u) != 0u || (overlay.rawCodeSize & 3u) != 0u || (overlay.rawEntry & 3u) != 0u)
+                throw std::invalid_argument("[overlay] code_offset, code_size and entry must be 4-byte aligned");

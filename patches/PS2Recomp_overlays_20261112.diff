+        constexpr uint64_t kEeRamSize = 32ull * 1024ull * 1024ull;
+        auto hex = [](uint64_t value)
+        {
+            std::ostringstream stream;
+            stream << "0x" << std::hex << value;
+            return stream.str();
+        };
+        auto fail = [this](const std::string &message)

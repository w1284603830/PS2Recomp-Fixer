+            cpu.gpr[4] = a0;
+            cpu.gpr[5] = a1;
+            cpu.gpr[6] = a2;
+            if (!sysmem.dispatchImport(ordinal, cpu))
+                return 0xDEAD0000u;
+            return cpu.gpr[2];
+        };

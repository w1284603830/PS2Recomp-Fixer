diff --git a/ps2xRuntime/CMakeLists.txt b/ps2xRuntime/CMakeLists.txt
index b121fde..d53a6be 100644
--- a/ps2xRuntime/CMakeLists.txt
+++ b/ps2xRuntime/CMakeLists.txt
@@ -429,0 +430,3 @@ add_library(ps2_runtime STATIC
+    src/lib/ps2_host_cpu.cpp
+    src/lib/ps2_host_os.cpp
+    src/lib/ps2_host_report.cpp
@@ -556,0 +560,21 @@ endif()
+# [Fixer] Release code generation. ps2_runtime is built with link-time code generation: the scheduler, memory and
+# timer paths call each other across files on every guest block (EeScheduler::accountCycles ->
+# PS2Memory::advanceEeTimers / PS2Runtime::advanceIopEeCycles), which only LTCG can inline. Generated code is not:
+# 10k files would make every link a whole-program build. Generated code drops /GS (no buffer-overrun cookies in
+# translated guest code); main.cpp keeps it.
+option(PS2X_RUNTIME_LTCG "Link-time code generation for ps2_runtime (MSVC Release)" ON)
+if(MSVC)
+    if(PS2X_RUNTIME_LTCG)
+        set_property(TARGET ps2_runtime PROPERTY INTERPROCEDURAL_OPTIMIZATION_RELEASE ON)
+        target_link_options(ps2EntryRunner PRIVATE $<$<CONFIG:Release>:/LTCG>)
+    endif()
+    target_compile_options(ps2EntryRunner PRIVATE /GS-)
+    # 16 MB default thread stack reserve (address space only; pages are committed as used). Some generated functions
+    # have frames of 0.7 MB (measured in one port), so one nested call of two of them overflowed the
+    # 1 MB default; guest call chains run as native recursion on the EE thread.
+    target_link_options(ps2EntryRunner PRIVATE /STACK:16777216)
+    if(EXISTS "${RUNNER_MAIN_CPP}")
+        set_source_files_properties("${RUNNER_MAIN_CPP}" PROPERTIES COMPILE_OPTIONS /GS)
+    endif()
+endif()
+
diff --git a/ps2xRuntime/include/ps2_host_cpu.h b/ps2xRuntime/include/ps2_host_cpu.h
new file mode 100644
index 0000000..592ab5a
--- /dev/null
+++ b/ps2xRuntime/include/ps2_host_cpu.h
@@ -0,0 +1,37 @@
+#ifndef PS2_HOST_CPU_H
+#define PS2_HOST_CPU_H
+
+// [Fixer] Host CPU capability report, read before anything ISA-specific runs.
+//
+// The runtime, the generated code and pcsx2gs.dll use SSE4.1 (blendv, pmaxsd, PCSX2's baseline). AVX/AVX2 are only
+// used behind run-time checks (microVU JIT, CRT, FFmpeg). A host without SSE4.1 cannot run the port at all; checking
+// first turns the illegal-instruction crash into a readable message. The report also names the host for user logs
+// ("old Xeon cannot start" reports): brand, logical cores and which vector ISA the OS actually enables (AVX needs
+// OSXSAVE + XCR0 YMM state, not only the CPUID bit).
+
+#include <string>
+
+namespace ps2host
+{
+    struct CpuReport
+    {
+        std::string vendor;
+        std::string brand;
+        unsigned logicalCores = 0;
+        bool sse41 = false;
+        bool sse42 = false;
+        bool popcnt = false;
+        bool osAvx = false; // CPUID AVX + OSXSAVE + XCR0[2:1] == 11b
+        bool avx2 = false;  // only meaningful with osAvx
+        bool fma = false;   // only meaningful with osAvx
+        bool bmi2 = false;
+    };
+
+    CpuReport cpuReport();
+
+    // Logs one "[cpu] ..." line to stderr and returns whether the host meets the runtime's baseline (SSE4.1).
+    // `missing` receives a short user-facing reason when it does not.
+    bool cpuMeetsBaseline(std::string *missing = nullptr);
+}
+
+#endif
diff --git a/ps2xRuntime/include/ps2_host_os.h b/ps2xRuntime/include/ps2_host_os.h
new file mode 100644
index 0000000..9cf6690
--- /dev/null
+++ b/ps2xRuntime/include/ps2_host_os.h
@@ -0,0 +1,60 @@
+#ifndef PS2_HOST_OS_H
+#define PS2_HOST_OS_H
+
+// [Fixer] Host OS scheduling and crash reporting, game-neutral.
+//
+// Power throttling: Windows 10/11 may run a process under EcoQoS (lower clocks, efficiency cores on hybrid CPUs)
+// when its window is not in the foreground, on battery or in power-saver plans, and Windows 11 may also ignore its
+// timer-resolution request while the window is hidden. The emulated EE has a real-time budget per field, so the port
+// opts out of both (SetProcessInformation(ProcessPowerThrottling), as games and media players do).
+// Thread roles: the EE (game) and GS threads run one step above normal priority on hosts with at least 4 logical
+// CPUs, so background work does not preempt them mid-field; on smaller hosts they stay normal so the window, audio and
+// IOP threads are never starved. PS2_THREAD_PRIORITY=0 keeps every thread normal.
+// Crash reports: an unhandled exception writes logs\crash-<time>.dmp (a minidump: threads, stacks, modules) and one
+// "[crash]" line with the exception code and module+offset, so "it closes on my PC" reports carry evidence.
+
+#include <cstdint>
+#include <string>
+
+namespace ps2host
+{
+    enum class ThreadRole
+    {
+        Game, // the EE thread (generated code, scheduler)
+        Gs,   // the GS worker (pcsx2gs.dll)
+        Iop,  // the threaded IOP
+    };
+
+    // Once per process; logs one "[host] ..." line. Safe to call more than once.
+    void configureHostProcess();
+    // Applies the role's priority to the calling thread (see above).
+    void setCurrentThreadRole(ThreadRole role);
+    // Installs the unhandled-exception minidump writer (Windows). Safe to call more than once.
+    void installCrashHandler();
+    // Number of crash dumps written by this process (0 normally); for diagnostics exports.
+    uint32_t crashDumpsWritten();
+    // CPU time (user + kernel, seconds) of the last thread that took this role; negative when none did (perf overlay).
+    double threadCpuSeconds(ThreadRole role);
+
+    // [Fixer] The GPU the PCSX2 GS renders with: the adapter named in the GS options (adapter=..., the launcher's GPU
+    // choice) when present, else the first hardware adapter by Windows' high-performance preference (the GS's own
+    // automatic choice, D3D::GetAdapterByName), else DXGI adapter 0 (Windows before 10 1803).
+    struct GpuReport
+    {
+        bool found = false;
+        std::string name;
+        uint32_t vendorId = 0;
+        uint64_t dedicatedBytes = 0; // DXGI DedicatedVideoMemory: integrated GPUs report 128-512 MB
+        bool software = false;       // Microsoft Basic Render Driver (no GPU driver)
+        bool umaKnown = false;       // D3D12 answered the architecture query
+        bool uma = false;            // unified memory: an integrated GPU
+    };
+    GpuReport gpuReport(const std::string &adapterName = std::string());
+    // Ceiling for gs_scale = auto by GPU class: 4 on a discrete GPU (5x and more at 4K costs a lot for little), 2 on an
+    // integrated GPU (D3D12 reports unified memory; without D3D12: under 1 GiB dedicated memory), 1 on the software
+    // renderer. tier receives "discrete" / "integrated" / "software". PS2_GPU_TIER=integrated|discrete|software
+    // replaces the detected class (tests).
+    int autoScaleCap(const GpuReport &gpu, const char **tier = nullptr);
+}
+
+#endif
diff --git a/ps2xRuntime/include/ps2_host_report.h b/ps2xRuntime/include/ps2_host_report.h
new file mode 100644
index 0000000..b31dc92
--- /dev/null
+++ b/ps2xRuntime/include/ps2_host_report.h
@@ -0,0 +1,36 @@
+#ifndef PS2_HOST_REPORT_H
+#define PS2_HOST_REPORT_H
+
+// [Fixer] Player-facing performance overlay and diagnostics package, game-neutral (generic host service).
+//
+// Overlay: once a second the window thread samples the fields presented, the game's own frames (DISPFB changes),
+// and the CPU time of the EE and GS threads, and (when on) shows one line at the bottom left of the image through the
+// GS's on-screen text: "30 fps (60 fields/s) | EE 48% | GS 10% | D3D11 3x". With it a player's screenshot tells
+// whether a slowdown is the CPU (EE near 100 % of a core), the GPU/driver (GS high, EE low) or the game itself
+// (frames halved, fields steady). Shown only by the PCSX2 GS (the CPU raster has no text layer).
+// Diagnostics package: <exe>\logs\diagnostics-<time>.zip (stored, no compression) with summary.txt (CPU, OS,
+// memory, GPU, renderer, the last samples, crash dumps), logs\last-run.log, logs\gpu.txt, the port's settings file
+// and the two newest crash dumps. Saves and game data are never included. Written on a worker thread.
+// PS2_PERF_OVERLAY=1 turns the overlay on at start (tests).
+
+#include <string>
+
+namespace ps2_host_report
+{
+    // Window thread: overlay on / off (the port's saved setting, the in-game menu).
+    void setOverlay(bool on);
+    bool overlay();
+    // Window thread, once per host frame (after the menu's tick): samples, updates the overlay.
+    void hostTick();
+    // Any thread: the last sample as one line ("" before the first second).
+    std::string lastSample();
+    // Any thread: CPU / GPU / renderer lines for the menu's status page.
+    std::string hostSummary();
+    // Any thread: starts writing the package (ignored while one is being written); settingsFile is the port's
+    // settings file name next to the EXE ("game.ini"; empty = none).
+    void exportDiagnostics(const std::string &settingsFile);
+    // Any thread: "" before any export, else a short user-facing status (busy / written to ... / failed).
+    std::string exportStatus();
+}
+
+#endif

@@ -0,0 +1,113 @@
+// [Fixer] Host CPU capability report (ps2_host_cpu.h). Plain CPUID/XGETBV only: this file must not contain any
+// instruction beyond the x64 baseline, because it runs before the SSE4.1 check passes.
+#include "ps2_host_cpu.h"
+
+#include <cstdio>
+#include <cstring>
+#include <thread>
+
+#if defined(_MSC_VER)
+#include <intrin.h>
+#elif defined(__x86_64__) || defined(__i386__)
+#include <cpuid.h>
+#endif
+
+namespace
+{
+    void cpuid(int out[4], int leaf, int subleaf = 0)
+    {
+#if defined(_MSC_VER)
+        __cpuidex(out, leaf, subleaf);
+#elif defined(__x86_64__) || defined(__i386__)
+        unsigned a = 0, b = 0, c = 0, d = 0;
+        __cpuid_count(leaf, subleaf, a, b, c, d);
+        out[0] = static_cast<int>(a);
+        out[1] = static_cast<int>(b);
+        out[2] = static_cast<int>(c);
+        out[3] = static_cast<int>(d);
+#else
+        out[0] = out[1] = out[2] = out[3] = 0;
+#endif
+    }
+
+    unsigned long long xgetbv0()
+    {
+#if defined(_MSC_VER)
+        return _xgetbv(0);
+#elif defined(__x86_64__) || defined(__i386__)
+        unsigned eax = 0, edx = 0;
+        __asm__ volatile("xgetbv" : "=a"(eax), "=d"(edx) : "c"(0));
+        return (static_cast<unsigned long long>(edx) << 32) | eax;
+#else
+        return 0;
+#endif
+    }
+}
+
+namespace ps2host
+{
+    CpuReport cpuReport()
+    {
+        CpuReport r;
+        r.logicalCores = std::thread::hardware_concurrency();
+#if defined(_M_X64) || defined(_M_IX86) || defined(__x86_64__) || defined(__i386__)
+        int regs[4] = {};
+        cpuid(regs, 0);
+        const int maxLeaf = regs[0];
+        char vendor[13] = {};
+        std::memcpy(vendor + 0, &regs[1], 4);
+        std::memcpy(vendor + 4, &regs[3], 4);
+        std::memcpy(vendor + 8, &regs[2], 4);
+        r.vendor = vendor;
+        if (maxLeaf >= 1)
+        {
+            cpuid(regs, 1);
+            const unsigned ecx = static_cast<unsigned>(regs[2]);
+            r.sse41 = (ecx >> 19) & 1u;
+            r.sse42 = (ecx >> 20) & 1u;
+            r.popcnt = (ecx >> 23) & 1u;
+            const bool fmaBit = (ecx >> 12) & 1u;
+            const bool osxsave = (ecx >> 27) & 1u;
+            const bool avxBit = (ecx >> 28) & 1u;
+            r.osAvx = avxBit && osxsave && (xgetbv0() & 6ull) == 6ull;
+            r.fma = r.osAvx && fmaBit;
+            if (maxLeaf >= 7)
+            {
+                cpuid(regs, 7, 0);
+                const unsigned ebx = static_cast<unsigned>(regs[1]);
+                r.avx2 = r.osAvx && ((ebx >> 5) & 1u);
+                r.bmi2 = (ebx >> 8) & 1u;
+            }
+        }
+        cpuid(regs, static_cast<int>(0x80000000u));
+        if (static_cast<unsigned>(regs[0]) >= 0x80000004u)
+        {
+            char brand[49] = {};
+            for (int i = 0; i < 3; ++i)
+            {
+                cpuid(regs, static_cast<int>(0x80000002u + i));
+                std::memcpy(brand + 16 * i, regs, 16);
+            }
+            const char *start = brand;
+            while (*start == ' ')
+                ++start;
+            r.brand = start;
+        }
+#endif
+        return r;
+    }
+
+    bool cpuMeetsBaseline(std::string *missing)
+    {
+        const CpuReport r = cpuReport();
+        std::fprintf(stderr, "[cpu] %s | %s | %u logical | SSE4.1 %s SSE4.2 %s AVX(OS) %s AVX2 %s FMA %s BMI2 %s\n",
+                     r.brand.empty() ? "?" : r.brand.c_str(), r.vendor.c_str(), r.logicalCores,
+                     r.sse41 ? "yes" : "NO", r.sse42 ? "yes" : "no", r.osAvx ? "yes" : "no", r.avx2 ? "yes" : "no",
+                     r.fma ? "yes" : "no", r.bmi2 ? "yes" : "no");
+        if (r.sse41)
+            return true;
+        if (missing)
+            *missing = "CPU lacks SSE4.1 (" + (r.brand.empty() ? r.vendor : r.brand) + ")";
+        return false;
+    }
+}
diff --git a/ps2xRuntime/src/lib/ps2_host_os.cpp b/ps2xRuntime/src/lib/ps2_host_os.cpp
new file mode 100644
index 0000000..a516b32
--- /dev/null
+++ b/ps2xRuntime/src/lib/ps2_host_os.cpp
@@ -0,0 +1,408 @@
+// [Fixer] Host OS scheduling and crash reporting (ps2_host_os.h). Windows only; other hosts get no-ops.
+#include "ps2_host_os.h"
+
+#include <atomic>
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <cwchar>
+#include <thread>
+
+#if defined(_WIN32)
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#include <windows.h>
+#include <dbghelp.h>
+#include <dxgi1_6.h>
+#include <d3d12.h>
+#include <exception>
+#include <string>
+#include <vector>
+#include <algorithm>
+#endif
+
+#if defined(_WIN32)
+// [Fixer] Dual-GPU laptops: ask the NVIDIA Optimus / AMD PowerXpress drivers for the discrete GPU. The PCSX2 GS already
+// picks the high-performance adapter through DXGI on Windows 10 1803+; these exports cover older systems and the
+// OpenGL host presentation used by the CPU-raster fallback. Exported from the EXE (this object is always linked).
+extern "C"
+{
+    __declspec(dllexport) unsigned long NvOptimusEnablement = 1;
+    __declspec(dllexport) int AmdPowerXpressRequestHighPerformance = 1;
+}
+#endif
+
+namespace
+{
+    std::atomic<uint32_t> g_dumpsWritten{0};
+#if defined(_WIN32)
+    std::atomic<HANDLE> g_roleThreads[3] = {}; // ThreadRole -> a handle of the thread that took it (perf overlay)
+#endif
+
+    bool priorityRaiseAllowed()
+    {
+        const char *v = std::getenv("PS2_THREAD_PRIORITY");
+        if (v && v[0] == '0')
+            return false;
+        return std::thread::hardware_concurrency() >= 4u;
+    }
+
+#if defined(_WIN32)
+    // Win32 output without the CRT stream locks (a crash may happen while one is held).
+    void writeStderr(const char *text)
+    {
+        const HANDLE err = GetStdHandle(STD_ERROR_HANDLE);
+        if (err && err != INVALID_HANDLE_VALUE)
+        {
+            DWORD written = 0;
+            WriteFile(err, text, static_cast<DWORD>(std::strlen(text)), &written, nullptr);
+        }
+    }
+
+    using MiniDumpWriteDumpFn = BOOL(WINAPI *)(HANDLE, DWORD, HANDLE, MINIDUMP_TYPE,
+                                               PMINIDUMP_EXCEPTION_INFORMATION, PMINIDUMP_USER_STREAM_INFORMATION,
+                                               PMINIDUMP_CALLBACK_INFORMATION);
+    MiniDumpWriteDumpFn g_writeDump = nullptr;
+    wchar_t g_dumpDir[MAX_PATH] = {};
+    std::atomic<bool> g_inCrash{false};
+    std::atomic<bool> g_crashInstalled{false};
+    LPTOP_LEVEL_EXCEPTION_FILTER g_previousFilter = nullptr;
+    constexpr size_t kKeepDumps = 4u; // a crash loop must not fill the disk
+
+    void pruneOldDumps()
+    {
+        std::wstring pattern = std::wstring(g_dumpDir) + L"\\crash-*.dmp";
+        WIN32_FIND_DATAW data;
+        const HANDLE find = FindFirstFileW(pattern.c_str(), &data);
+        if (find == INVALID_HANDLE_VALUE)
+            return;
+        std::vector<std::wstring> names;
+        do
+            names.emplace_back(data.cFileName);
+        while (FindNextFileW(find, &data));
+        FindClose(find);
+        std::sort(names.begin(), names.end()); // crash-YYYYMMDD-HHMMSS: name order is time order
+        while (names.size() >= kKeepDumps)
+        {
+            DeleteFileW((std::wstring(g_dumpDir) + L"\\" + names.front()).c_str());
+            names.erase(names.begin());
+        }
+    }
+
+    void writeDump(EXCEPTION_POINTERS *exception, const char *reason)
+    {
+        char line[512];
+        if (exception && exception->ExceptionRecord)
+        {
+            const EXCEPTION_RECORD &record = *exception->ExceptionRecord;
+            const void *address = record.ExceptionAddress;
+            HMODULE module = nullptr;
+            wchar_t modulePath[MAX_PATH] = L"?";
+            if (GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+                                   static_cast<LPCWSTR>(address), &module) && module)
+                GetModuleFileNameW(module, modulePath, MAX_PATH);
+            const wchar_t *base = modulePath;
+            for (const wchar_t *p = modulePath; *p; ++p)
+                if (*p == L'\\' || *p == L'/')
+                    base = p + 1;
+            std::snprintf(line, sizeof(line), "[crash] %s: exception 0x%08lX at %ls+0x%llX (thread %lu)\n", reason,
+                          static_cast<unsigned long>(record.ExceptionCode), base,
+                          static_cast<unsigned long long>(reinterpret_cast<uintptr_t>(address) -
+                                                          reinterpret_cast<uintptr_t>(module)),
+                          static_cast<unsigned long>(GetCurrentThreadId()));
+        }
+        else
+        {
+            std::snprintf(line, sizeof(line), "[crash] %s (thread %lu)\n", reason,
+                          static_cast<unsigned long>(GetCurrentThreadId()));
+        }
+        writeStderr(line);
+        if (!g_writeDump || !g_dumpDir[0])
+            return;
+        CreateDirectoryW(g_dumpDir, nullptr);
+        pruneOldDumps();
+        SYSTEMTIME now;
+        GetLocalTime(&now);
+        wchar_t path[MAX_PATH + 64];
+        swprintf(path, sizeof(path) / sizeof(path[0]), L"%ls\\crash-%04u%02u%02u-%02u%02u%02u.dmp", g_dumpDir,
+                 now.wYear, now.wMonth, now.wDay, now.wHour, now.wMinute, now.wSecond);
+        const HANDLE file = CreateFileW(path, GENERIC_WRITE, 0, nullptr, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, nullptr);
+        if (file == INVALID_HANDLE_VALUE)
+            return;
+        MINIDUMP_EXCEPTION_INFORMATION info{};
+        info.ThreadId = GetCurrentThreadId();
+        info.ExceptionPointers = exception;
+        info.ClientPointers = FALSE;
+        const MINIDUMP_TYPE type = static_cast<MINIDUMP_TYPE>(MiniDumpWithThreadInfo | MiniDumpWithUnloadedModules |
+                                                              MiniDumpWithIndirectlyReferencedMemory);
+        const BOOL ok = g_writeDump(GetCurrentProcess(), GetCurrentProcessId(), file, type,
+                                    exception ? &info : nullptr, nullptr, nullptr);
+        CloseHandle(file);
+        if (ok)
+        {
+            g_dumpsWritten.fetch_add(1u, std::memory_order_relaxed);
+            std::snprintf(line, sizeof(line), "[crash] minidump: %ls\n", path);
+        }
+        else
+        {
+            DeleteFileW(path);
+            std::snprintf(line, sizeof(line), "[crash] minidump failed (error %lu)\n",
+                          static_cast<unsigned long>(GetLastError()));
+        }
+        writeStderr(line);
+    }
+
+    LONG WINAPI crashFilter(EXCEPTION_POINTERS *exception)
+    {
+        if (!g_inCrash.exchange(true))
+            writeDump(exception, "unhandled exception");
+        return g_previousFilter ? g_previousFilter(exception) : EXCEPTION_CONTINUE_SEARCH;
+    }
+
+    [[noreturn]] void onTerminate()
+    {
+        if (!g_inCrash.exchange(true))
+            writeDump(nullptr, "std::terminate (uncaught C++ exception)");
+        std::abort();
+    }
+#endif
+}
+
+namespace ps2host
+{
+    void configureHostProcess()
+    {
+#if defined(_WIN32)
+        static std::atomic<bool> done{false};
+        if (done.exchange(true))
+            return;
+        // PROCESS_POWER_THROTTLING_STATE; constants spelled out for older SDKs.
+        struct PowerThrottlingState
+        {
+            ULONG Version, ControlMask, StateMask;
+        };
+        constexpr int kProcessPowerThrottling = 4;
+        constexpr ULONG kExecutionSpeed = 0x1u, kIgnoreTimerResolution = 0x4u;
+        using SetProcessInformationFn = BOOL(WINAPI *)(HANDLE, int, LPVOID, DWORD);
+        const auto setInfo = reinterpret_cast<SetProcessInformationFn>(
+            GetProcAddress(GetModuleHandleW(L"kernel32.dll"), "SetProcessInformation"));
+        const char *result = "unavailable (Windows 7/8)";
+        if (setInfo)
+        {
+            PowerThrottlingState state{1u, kExecutionSpeed | kIgnoreTimerResolution, 0u};
+            if (setInfo(GetCurrentProcess(), kProcessPowerThrottling, &state, sizeof(state)))
+                result = "off (no EcoQoS, timer resolution kept when hidden)";
+            else
+            {
+                state.ControlMask = kExecutionSpeed; // Windows 10 before 21H2 rejects the timer flag
+                result = setInfo(GetCurrentProcess(), kProcessPowerThrottling, &state, sizeof(state))
+                             ? "off (no EcoQoS)"
+                             : "unchanged (SetProcessInformation failed)";
+            }
+        }
+        std::fprintf(stderr, "[host] power throttling %s; EE/GS threads %s priority\n", result,
+                     priorityRaiseAllowed() ? "above-normal" : "normal");
+#endif
+    }
+
+    void setCurrentThreadRole(ThreadRole role)
+    {
+#if defined(_WIN32)
+        if ((role == ThreadRole::Game || role == ThreadRole::Gs) && priorityRaiseAllowed())
+            SetThreadPriority(GetCurrentThread(), THREAD_PRIORITY_ABOVE_NORMAL);
+        HANDLE self = nullptr;
+        if (DuplicateHandle(GetCurrentProcess(), GetCurrentThread(), GetCurrentProcess(), &self,
+                            THREAD_QUERY_LIMITED_INFORMATION, FALSE, 0))
+        {
+            if (const HANDLE previous = g_roleThreads[static_cast<int>(role)].exchange(self))
+                CloseHandle(previous);
+        }
+        if (role == ThreadRole::Gs) // named for per-thread reports (the EE and IOP threads name themselves)
+        {
+            using SetThreadDescriptionFn = HRESULT(WINAPI *)(HANDLE, PCWSTR);
+            if (const auto describe = reinterpret_cast<SetThreadDescriptionFn>(
+                    GetProcAddress(GetModuleHandleW(L"kernel32.dll"), "SetThreadDescription")))
+                describe(GetCurrentThread(), L"dod GS");
+        }
+#else
+        (void)role;
+#endif
+    }
+
+    void installCrashHandler()
+    {
+#if defined(_WIN32)
+        if (g_crashInstalled.exchange(true))
+            return;
+        // Loaded now: LoadLibrary inside a crashing process can deadlock on the loader lock.
+        if (const HMODULE dbghelp = LoadLibraryW(L"dbghelp.dll"))
+            g_writeDump = reinterpret_cast<MiniDumpWriteDumpFn>(GetProcAddress(dbghelp, "MiniDumpWriteDump"));
+        // <exe folder>\logs, where the launcher keeps last-run.log (the working directory may differ).
+        const DWORD n = GetModuleFileNameW(nullptr, g_dumpDir, MAX_PATH - 8);
+        wchar_t *slash = nullptr;
+        for (wchar_t *p = g_dumpDir; n > 0 && n < MAX_PATH - 8 && *p; ++p)
+            if (*p == L'\\' || *p == L'/')
+                slash = p;
+        if (slash)
+            wcscpy_s(slash, MAX_PATH - static_cast<size_t>(slash - g_dumpDir), L"\\logs");
+        else
+            g_dumpDir[0] = 0;
+        g_previousFilter = SetUnhandledExceptionFilter(crashFilter);
+        std::set_terminate(onTerminate);
+        // PS2_TEST_CRASH=<seconds> (tests only): an access violation on a worker thread after that many seconds.
+        if (const char *v = std::getenv("PS2_TEST_CRASH"); v && std::atoi(v) > 0)
+        {
+            const int seconds = std::atoi(v);
+            std::thread([seconds] {
+                std::this_thread::sleep_for(std::chrono::seconds(seconds));
+                volatile int *const nowhere = nullptr;
+                *nowhere = 1;
+            }).detach();
+        }
+#endif
+    }
+
+    uint32_t crashDumpsWritten()
+    {
+        return g_dumpsWritten.load(std::memory_order_relaxed);
+    }
+
+    GpuReport gpuReport(const std::string &adapterName)
+    {
+        GpuReport r;
+#if defined(_WIN32)
+        using CreateFactoryFn = HRESULT(WINAPI *)(REFIID, void **);
+        const HMODULE dxgi = LoadLibraryW(L"dxgi.dll");
+        const auto create = dxgi ? reinterpret_cast<CreateFactoryFn>(GetProcAddress(dxgi, "CreateDXGIFactory1")) : nullptr;
+        IDXGIFactory1 *factory = nullptr;
+        if (!create || FAILED(create(__uuidof(IDXGIFactory1), reinterpret_cast<void **>(&factory))) || !factory)
+            return r;
+        const auto utf8 = [](const wchar_t *text) {
+            char out[256] = {};
+            WideCharToMultiByte(CP_UTF8, 0, text, -1, out, sizeof(out) - 1, nullptr, nullptr);
+            std::string s(out);
+            while (!s.empty() && s.back() == ' ')
+                s.pop_back();
+            while (!s.empty() && s.front() == ' ')
+                s.erase(s.begin());
+            return s;
+        };
+        IDXGIAdapter1 *chosen = nullptr;
+        const auto take = [&](IDXGIAdapter1 *adapter) {
+            DXGI_ADAPTER_DESC1 desc{};
+            if (FAILED(adapter->GetDesc1(&desc)))
+                return false;
+            adapter->AddRef();
+            chosen = adapter;
+            r.found = true;
+            r.name = utf8(desc.Description);
+            r.vendorId = desc.VendorId;
+            r.dedicatedBytes = desc.DedicatedVideoMemory;
+            r.software = (desc.Flags & DXGI_ADAPTER_FLAG_SOFTWARE) != 0;
+            return true;
+        };
+        std::string wanted = adapterName;
+        if (wanted == "auto")
+            wanted.clear();
+        for (UINT i = 0; !wanted.empty() && !r.found; ++i)
+        {
+            IDXGIAdapter1 *adapter = nullptr;
+            if (FAILED(factory->EnumAdapters1(i, &adapter)))
+                break;
+            DXGI_ADAPTER_DESC1 desc{};
+            if (SUCCEEDED(adapter->GetDesc1(&desc)) && utf8(desc.Description) == wanted)
+                take(adapter);
+            adapter->Release();
+        }
+        IDXGIFactory6 *factory6 = nullptr;
+        if (!r.found && SUCCEEDED(factory->QueryInterface(__uuidof(IDXGIFactory6), reinterpret_cast<void **>(&factory6))))
+        {
+            for (UINT i = 0; !r.found; ++i)
+            {
+                IDXGIAdapter1 *adapter = nullptr;
+                if (FAILED(factory6->EnumAdapterByGpuPreference(i, DXGI_GPU_PREFERENCE_HIGH_PERFORMANCE,
+                                                                __uuidof(IDXGIAdapter1), reinterpret_cast<void **>(&adapter))))
+                    break;
+                DXGI_ADAPTER_DESC1 desc{};
+                if (SUCCEEDED(adapter->GetDesc1(&desc)) && !(desc.Flags & DXGI_ADAPTER_FLAG_SOFTWARE))
+                    take(adapter);
+                adapter->Release();
+            }
+            factory6->Release();
+        }
+        if (!r.found)
+        {
+            IDXGIAdapter1 *adapter = nullptr;
+            if (SUCCEEDED(factory->EnumAdapters1(0, &adapter)))
+            {
+                take(adapter);
+                adapter->Release();
+            }
+        }
+        // Integrated GPUs share system memory (UMA). DXGI has no such flag and an APU may report a 2 GB BIOS carve-out as
+        // "dedicated", so ask D3D12 when it is available (Windows 10); the 1 GiB rule is the fallback.
+        if (chosen && !r.software)
+        {
+            using CreateDeviceFn = HRESULT(WINAPI *)(IUnknown *, D3D_FEATURE_LEVEL, REFIID, void **);
+            const HMODULE d3d12 = LoadLibraryW(L"d3d12.dll");
+            const auto createDevice =
+                d3d12 ? reinterpret_cast<CreateDeviceFn>(GetProcAddress(d3d12, "D3D12CreateDevice")) : nullptr;
+            ID3D12Device *device = nullptr;
+            if (createDevice && SUCCEEDED(createDevice(chosen, D3D_FEATURE_LEVEL_11_0, __uuidof(ID3D12Device),
+                                                       reinterpret_cast<void **>(&device))) && device)
+            {
+                D3D12_FEATURE_DATA_ARCHITECTURE arch{};
+                if (SUCCEEDED(device->CheckFeatureSupport(D3D12_FEATURE_ARCHITECTURE, &arch, sizeof(arch))))
+                {
+                    r.umaKnown = true;
+                    r.uma = arch.UMA != FALSE;
+                }
+                device->Release();
+            }
+        }
+        if (chosen)
+            chosen->Release();
+        factory->Release();
+#else
+        (void)adapterName;
+#endif
+        return r;
+    }
+
+    int autoScaleCap(const GpuReport &gpu, const char **tier)
+    {
+        const char *kind = !gpu.found ? "discrete" // unknown: keep the display-based choice up to 4x
+                           : gpu.software ? "software"
+                           : gpu.umaKnown ? (gpu.uma ? "integrated" : "discrete")
+                           : gpu.dedicatedBytes < (1ull << 30) ? "integrated"
+                                                                : "discrete";
+        if (const char *v = std::getenv("PS2_GPU_TIER"); v && *v)
+            kind = std::strcmp(v, "integrated") == 0 ? "integrated" : std::strcmp(v, "software") == 0 ? "software"
+                                                                                                       : "discrete";
+        if (tier)
+            *tier = kind;
+        return std::strcmp(kind, "software") == 0 ? 1 : std::strcmp(kind, "integrated") == 0 ? 2 : 4;
+    }
+
+    double threadCpuSeconds(ThreadRole role)
+    {
+#if defined(_WIN32)
+        const HANDLE thread = g_roleThreads[static_cast<int>(role)].load();
+        FILETIME created, exited, kernel, user;
+        if (!thread || !GetThreadTimes(thread, &created, &exited, &kernel, &user))
+            return -1.0;
+        const auto seconds = [](const FILETIME &t) {
+            return static_cast<double>((static_cast<uint64_t>(t.dwHighDateTime) << 32) | t.dwLowDateTime) * 1e-7;
+        };
+        return seconds(kernel) + seconds(user);
+#else
+        (void)role;
+        return -1.0;
+#endif
+    }
+}
diff --git a/ps2xRuntime/src/lib/ps2_host_report.cpp b/ps2xRuntime/src/lib/ps2_host_report.cpp
new file mode 100644
index 0000000..d3ec523
--- /dev/null
+++ b/ps2xRuntime/src/lib/ps2_host_report.cpp
@@ -0,0 +1,463 @@
+// [Fixer] Performance overlay and diagnostics package (ps2_host_report.h). No raylib here (windows.h is included).
+#include "ps2_host_report.h"
+
+#include "gs/dod_pcsx2_gs.h"
+#include "ps2_host_cpu.h"
+#include "ps2_host_os.h"
+
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <ctime>
+#include <deque>
+#include <filesystem>
+#include <fstream>
+#include <iterator>
+#include <mutex>
+#include <string>
+#include <thread>
+#include <utility>
+#include <vector>
+
+#if defined(_WIN32)
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#include <windows.h>
+#endif
+
+namespace ps2_host_report
+{
+    namespace
+    {
+        namespace fs = std::filesystem;
+        using Clock = std::chrono::steady_clock;
+
+        std::atomic<bool> g_overlay{false};
+        bool g_overlayShown = false; // window thread
+        bool g_envChecked = false;   // window thread
+        std::mutex g_lock;
+        std::string g_last;
+        std::deque<std::string> g_history; // the last minute of samples, for the package
+        std::string g_status;
+        std::atomic<bool> g_busy{false};
+        std::string g_summary; // the menu's status lines, refreshed with each sample (the menu draws every frame)
+        std::string g_gpu;     // window thread: the GPU line once logs\gpu.txt exists
+
+        struct Sampler
+        {
+            bool started = false;
+            Clock::time_point at;
+            uint64_t presents = 0, flips = 0;
+            double ee = -1.0, gs = -1.0;
+        } g_sampler;
+
+        fs::path exeDir()
+        {
+#if defined(_WIN32)
+            wchar_t path[MAX_PATH] = {};
+            const DWORD n = GetModuleFileNameW(nullptr, path, MAX_PATH);
+            if (n > 0 && n < MAX_PATH)
+                return fs::path(path).parent_path();
+#endif
+            std::error_code ec;
+            return fs::current_path(ec);
+        }
+
+        std::string readFile(const fs::path &path, size_t limit = static_cast<size_t>(-1));
+        std::string cpuLine();
+
+        std::string percent(double cpuNow, double cpuThen, double seconds)
+        {
+            if (cpuNow < 0.0 || cpuThen < 0.0 || seconds <= 0.0)
+                return "?";
+            char text[16];
+            std::snprintf(text, sizeof(text), "%.0f%%", std::max(0.0, (cpuNow - cpuThen) / seconds * 100.0));
+            return text;
+        }
+
+        void sample()
+        {
+            const Clock::time_point now = Clock::now();
+            const uint64_t presents = dodpcsx2::presents();
+            const uint64_t flips = dodpcsx2::flips();
+            const double ee = ps2host::threadCpuSeconds(ps2host::ThreadRole::Game);
+            const double gs = ps2host::threadCpuSeconds(ps2host::ThreadRole::Gs);
+            if (g_sampler.started)
+            {
+                const double seconds = std::chrono::duration<double>(now - g_sampler.at).count();
+                char line[160];
+                std::snprintf(line, sizeof(line), "%.0f fps (%.0f fields/s) | EE %s | GS %s | %s %dx",
+                              static_cast<double>(flips - g_sampler.flips) / seconds,
+                              static_cast<double>(presents - g_sampler.presents) / seconds,
+                              percent(ee, g_sampler.ee, seconds).c_str(), percent(gs, g_sampler.gs, seconds).c_str(),
+                              dodpcsx2::active() ? "D3D11" : "CPU raster", dodpcsx2::scale());
+                std::lock_guard<std::mutex> lock(g_lock);
+                g_last = line;
+                g_history.push_back(line);
+                while (g_history.size() > 60u)
+                    g_history.pop_front();
+            }
+            g_sampler = Sampler{true, now, presents, flips, ee, gs};
+            static const std::string cpu = cpuLine();
+            if (g_gpu.empty())
+            {
+                std::string text = readFile(exeDir() / "logs" / "gpu.txt", 2048);
+                if (const size_t cut = text.find_first_of("\r\n"); cut != std::string::npos)
+                    text.resize(cut);
+                g_gpu = text;
+            }
+            std::string summary = "CPU: " + cpu + "\nGPU: " + (g_gpu.empty() ? std::string("?") : g_gpu) + "\n" +
+                                  (dodpcsx2::active() ? "D3D11" : "CPU raster") + " " +
+                                  std::to_string(dodpcsx2::scale()) + "x";
+            std::lock_guard<std::mutex> lock(g_lock);
+            g_summary = std::move(summary);
+        }
+
+        std::string readFile(const fs::path &path, size_t limit)
+        {
+            std::ifstream in(path, std::ios::binary); // MSVC opens shared (the launcher keeps last-run.log open)
+            if (!in)
+                return {};
+            std::string data((std::istreambuf_iterator<char>(in)), std::istreambuf_iterator<char>());
+            if (data.size() > limit)
+                data.erase(0, data.size() - limit); // keep the end of a long log
+            return data;
+        }
+
+        std::string osLine()
+        {
+#if defined(_WIN32)
+            struct OsVersion
+            {
+                ULONG size, major, minor, build, platform;
+                WCHAR csd[128];
+            } v{};
+            v.size = sizeof(v);
+            using RtlGetVersionFn = LONG(WINAPI *)(OsVersion *);
+            if (const auto get = reinterpret_cast<RtlGetVersionFn>(
+                    GetProcAddress(GetModuleHandleW(L"ntdll.dll"), "RtlGetVersion")))
+            {
+                if (get(&v) == 0)
+                {
+                    char text[64];
+                    std::snprintf(text, sizeof(text), "Windows %lu.%lu build %lu", v.major, v.minor, v.build);
+                    return text;
+                }
+            }
+            return "Windows (version unknown)";
+#else
+            return "non-Windows host";
+#endif
+        }
+
+        std::string memoryLine()
+        {
+#if defined(_WIN32)
+            MEMORYSTATUSEX m{};
+            m.dwLength = sizeof(m);
+            if (GlobalMemoryStatusEx(&m))
+            {
+                char text[80];
+                std::snprintf(text, sizeof(text), "%.1f GB total, %.1f GB available",
+                              m.ullTotalPhys / 1073741824.0, m.ullAvailPhys / 1073741824.0);
+                return text;
+            }
+#endif
+            return "unknown";
+        }
+
+        std::string cpuLine()
+        {
+            const ps2host::CpuReport r = ps2host::cpuReport();
+            char text[256];
+            std::snprintf(text, sizeof(text), "%s | %u logical | SSE4.1 %s AVX %s AVX2 %s",
+                          r.brand.empty() ? r.vendor.c_str() : r.brand.c_str(), r.logicalCores,
+                          r.sse41 ? "yes" : "NO", r.osAvx ? "yes" : "no", r.avx2 ? "yes" : "no");
+            return text;
+        }
+
+        std::string gpuLines(const fs::path &dir)
+        {
+            std::string text = readFile(dir / "logs" / "gpu.txt", 2048);
+            while (!text.empty() && (text.back() == '\n' || text.back() == '\r'))
+                text.pop_back();
+            return text.empty() ? "unknown (logs\\gpu.txt not written yet)" : text;
+        }
+
+        std::string timestamp(bool forFileName)
+        {
+            const std::time_t t = std::time(nullptr);
+            std::tm local{};
+#if defined(_WIN32)
+            localtime_s(&local, &t);
+#else
+            localtime_r(&t, &local);
+#endif
+            char text[32];
+            std::strftime(text, sizeof(text), forFileName ? "%Y%m%d-%H%M%S" : "%Y-%m-%d %H:%M:%S", &local);
+            return text;
+        }
+
+        // ---- ZIP (stored entries, UTF-8 names), enough for a support package.
+        uint32_t crc32(const std::string &data)
+        {
+            static uint32_t table[256];
+            static bool ready = false;
+            if (!ready)
+            {
+                for (uint32_t i = 0; i < 256u; ++i)
+                {
+                    uint32_t c = i;
+                    for (int k = 0; k < 8; ++k)
+                        c = (c & 1u) ? 0xEDB88320u ^ (c >> 1) : c >> 1;
+                    table[i] = c;
+                }
+                ready = true;
+            }
+            uint32_t crc = 0xFFFFFFFFu;
+            for (const unsigned char byte : data)
+                crc = table[(crc ^ byte) & 0xFFu] ^ (crc >> 8);
+            return crc ^ 0xFFFFFFFFu;
+        }
+
+        void put16(std::string &out, uint32_t v)
+        {
+            out.push_back(static_cast<char>(v & 0xFFu));
+            out.push_back(static_cast<char>((v >> 8) & 0xFFu));
+        }
+
+        void put32(std::string &out, uint32_t v)
+        {
+            put16(out, v & 0xFFFFu);
+            put16(out, v >> 16);
+        }
+
+        bool writeZip(const fs::path &path, const std::vector<std::pair<std::string, std::string>> &files)
+        {
+            const std::time_t t = std::time(nullptr);
+            std::tm local{};
+#if defined(_WIN32)
+            localtime_s(&local, &t);
+#else
+            localtime_r(&t, &local);
+#endif
+            const uint32_t dosTime = (local.tm_hour << 11) | (local.tm_min << 5) | (local.tm_sec / 2);
+            const uint32_t dosDate = ((local.tm_year + 1900 - 1980) << 9) | ((local.tm_mon + 1) << 5) | local.tm_mday;
+            std::ofstream out(path, std::ios::binary | std::ios::trunc);
+            if (!out)
+                return false;
+            std::string central;
+            uint32_t offset = 0;
+            for (const auto &[name, data] : files)
+            {
+                const uint32_t crc = crc32(data);
+                const uint32_t size = static_cast<uint32_t>(data.size());
+                std::string header;
+                put32(header, 0x04034B50u);
+                put16(header, 20u);
+                put16(header, 0x0800u); // UTF-8 names
+                put16(header, 0u);      // stored
+                put16(header, dosTime);
+                put16(header, dosDate);
+                put32(header, crc);
+                put32(header, size);
+                put32(header, size);
+                put16(header, static_cast<uint32_t>(name.size()));
+                put16(header, 0u);
+                header += name;
+                out.write(header.data(), static_cast<std::streamsize>(header.size()));
+                out.write(data.data(), static_cast<std::streamsize>(data.size()));
+                put32(central, 0x02014B50u);
+                put16(central, 20u);
+                put16(central, 20u);
+                put16(central, 0x0800u);
+                put16(central, 0u);
+                put16(central, dosTime);
+                put16(central, dosDate);
+                put32(central, crc);
+                put32(central, size);
+                put32(central, size);
+                put16(central, static_cast<uint32_t>(name.size()));
+                put16(central, 0u);
+                put16(central, 0u);
+                put16(central, 0u);
+                put16(central, 0u);
+                put32(central, 0u);
+                put32(central, offset);
+                central += name;
+                offset += static_cast<uint32_t>(header.size()) + size;
+            }
+            std::string end;
+            put32(end, 0x06054B50u);
+            put16(end, 0u);
+            put16(end, 0u);
+            put16(end, static_cast<uint32_t>(files.size()));
+            put16(end, static_cast<uint32_t>(files.size()));
+            put32(end, static_cast<uint32_t>(central.size()));
+            put32(end, offset);
+            put16(end, 0u);
+            out.write(central.data(), static_cast<std::streamsize>(central.size()));
+            out.write(end.data(), static_cast<std::streamsize>(end.size()));
+            return static_cast<bool>(out);
+        }
+
+        void setStatus(const std::string &text)
+        {
+            std::lock_guard<std::mutex> lock(g_lock);
+            g_status = text;
+        }
+
+        void writePackage(const std::string &settingsFile)
+        {
+            const fs::path dir = exeDir();
+            const fs::path logs = dir / "logs";
+            std::error_code ec;
+            fs::create_directories(logs, ec);
+            std::vector<std::pair<std::string, std::string>> files;
+
+            std::string summary = "PS2Recomp-Fixer diagnostics package\n";
+            summary += "written: " + timestamp(false) + " (local time)\n";
+            {
+                std::error_code e2;
+                const fs::path exe = [] {
+#if defined(_WIN32)
+                    wchar_t path[MAX_PATH] = {};
+                    GetModuleFileNameW(nullptr, path, MAX_PATH);
+                    return fs::path(path);
+#else
+                    return fs::path();
+#endif
+                }();
+                const auto bytes = fs::file_size(exe, e2);
+                summary += "exe: " + exe.filename().string() + " (" + std::to_string(e2 ? 0 : bytes) + " bytes)\n";
+            }
+            summary += "cpu: " + cpuLine() + "\n";
+            summary += "os: " + osLine() + "\n";
+            summary += "memory: " + memoryLine() + "\n";
+            summary += std::string("renderer: ") + (dodpcsx2::active() ? "D3D11 (pcsx2gs.dll)" : "CPU raster") +
+                       ", internal scale " + std::to_string(dodpcsx2::scale()) + "x\n";
+            summary += std::string("perf overlay: ") + (g_overlay.load() ? "on" : "off") + "\n";
+            summary += "crash dumps written by this run: " + std::to_string(ps2host::crashDumpsWritten()) + "\n";
+            {
+                std::lock_guard<std::mutex> lock(g_lock);
+                summary += "last samples (one per second, newest last):\n";
+                for (const std::string &line : g_history)
+                    summary += "  " + line + "\n";
+            }
+            summary += "gpu.txt:\n  " + gpuLines(dir) + "\n";
+            files.emplace_back("summary.txt", summary);
+
+            const auto add = [&](const fs::path &path, const std::string &name, size_t limit) {
+                std::error_code e3;
+                if (!fs::is_regular_file(path, e3))
+                    return;
+                std::string data = readFile(path, limit);
+                if (!data.empty())
+                    files.emplace_back(name, std::move(data));
+            };
+            add(logs / "last-run.log", "logs/last-run.log", 16u << 20);
+            add(logs / "gpu.txt", "logs/gpu.txt", 1u << 20);
+            if (!settingsFile.empty())
+                add(dir / settingsFile, settingsFile, 1u << 20);
+            std::vector<fs::path> dumps;
+            for (const auto &entry : fs::directory_iterator(logs, ec))
+            {
+                const std::string name = entry.path().filename().string();
+                if (name.rfind("crash-", 0) == 0 && entry.path().extension() == ".dmp")
+                    dumps.push_back(entry.path());
+            }
+            std::sort(dumps.begin(), dumps.end());
+            for (size_t i = dumps.size() > 2u ? dumps.size() - 2u : 0u; i < dumps.size(); ++i)
+                add(dumps[i], "logs/" + dumps[i].filename().string(), 256u << 20);
+
+            const std::string name = "diagnostics-" + timestamp(true) + ".zip";
+            if (writeZip(logs / name, files))
+            {
+                setStatus("Written to logs\\" + name);
+                std::fprintf(stderr, "[report] diagnostics package logs\\%s (%zu files)\n", name.c_str(), files.size());
+            }
+            else
+            {
+                setStatus("Export failed: cannot write the logs folder");
+                std::fprintf(stderr, "[report] diagnostics package failed (logs folder not writable)\n");
+            }
+        }
+    }
+
+    void setOverlay(bool on)
+    {
+        g_overlay.store(on);
+        g_envChecked = true; // an explicit choice wins over PS2_PERF_OVERLAY
+    }
+
+    bool overlay()
+    {
+        return g_overlay.load();
+    }
+
+    void hostTick()
+    {
+        if (!g_envChecked)
+        {
+            g_envChecked = true;
+            const char *v = std::getenv("PS2_PERF_OVERLAY");
+            if (v && v[0] == '1')
+                g_overlay.store(true);
+        }
+        const Clock::time_point now = Clock::now();
+        if (!g_sampler.started || now - g_sampler.at >= std::chrono::seconds(1))
+        {
+            sample();
+            if (g_overlay.load())
+            {
+                const std::string line = lastSample();
+                if (!line.empty())
+                {
+                    dodpcsx2::setOsdLine(line.c_str());
+                    g_overlayShown = true;
+                }
+            }
+        }
+        if (!g_overlay.load() && g_overlayShown)
+        {
+            dodpcsx2::setOsdLine("");
+            g_overlayShown = false;
+        }
+    }
+
+    std::string lastSample()
+    {
+        std::lock_guard<std::mutex> lock(g_lock);
+        return g_last;
+    }
+
+    std::string hostSummary()
+    {
+        std::lock_guard<std::mutex> lock(g_lock);
+        return g_summary;
+    }
+
+    void exportDiagnostics(const std::string &settingsFile)
+    {
+        if (g_busy.exchange(true))
+            return;
+        setStatus("Writing the diagnostics package...");
+        std::thread([settingsFile] {
+            writePackage(settingsFile);
+            g_busy.store(false);
+        }).detach();
+    }
+
+    std::string exportStatus()
+    {
+        std::lock_guard<std::mutex> lock(g_lock);
+        return g_status;
+    }
+}

diff --git a/ps2xRuntime/include/ps2_input_readers.h b/ps2xRuntime/include/ps2_input_readers.h
new file mode 100644
index 0000000..0f30882
--- /dev/null
+++ b/ps2xRuntime/include/ps2_input_readers.h
@@ -0,0 +1,50 @@
+#pragma once
+#include <array>
+#include <cstddef>
+#include <cstdint>
+
+namespace ps2input
+{
+using Reader = uint64_t;
+
+// Protected by the host-pad mutex in production. Each registered native adapter
+// acknowledges its own short presses; ordinary SIO2/HLE polling is independent.
+class PressReaders
+{
+    struct Slot { Reader token = 0; uint16_t pending = 0; };
+    std::array<Slot, 8> slots{};
+    Reader next = 1;
+public:
+    Reader add()
+    {
+        for (auto& s : slots) if (!s.token)
+        {
+            if (!next) ++next;
+            s = {next++, 0};
+            return s.token;
+        }
+        return 0;
+    }
+    bool remove(Reader token)
+    {
+        for (auto& s : slots) if (token && s.token == token) { s = {}; return true; }
+        return false;
+    }
+    void publish(uint16_t edges) { for (auto& s : slots) if (s.token) s.pending |= edges; }
+    void clearPending() { for (auto& s : slots) s.pending = 0; }
+    void reset() { slots = {}; } // retain generation: old tokens must not become valid again
+    bool consume(Reader token, uint16_t& edges)
+    {
+        for (auto& s : slots) if (token && s.token == token)
+        { edges = s.pending; s.pending = 0; return true; }
+        return false;
+    }
+};
+
+Reader registerReader();
+bool unregisterReader(Reader token);
+// 32-byte normalized host snapshot. Refresh only input fields in a separately
+// validated native packet; this API does not implement a game's libpad ABI.
+bool readLatest(Reader token, uint8_t* data, size_t size);
+void resetSession(); // before execution / after load; invalidates registered readers
+}
diff --git a/ps2xRuntime/include/ps2_pad_diagnostics.h b/ps2xRuntime/include/ps2_pad_diagnostics.h
new file mode 100644
index 0000000..9b7f34c
--- /dev/null
+++ b/ps2xRuntime/include/ps2_pad_diagnostics.h
@@ -0,0 +1,19 @@
+#pragma once
+#include <charconv>
+#include <cstdint>
+#include <string_view>
+
+namespace ps2input
+{
+// Explicit diagnostic RAM word, not a game's global or a mapped hardware register.
+inline uint32_t diagnosticWordAddress(const char* text)
+{
+    if (!text || !*text) return 0;
+    std::string_view s(text); int radix = 10;
+    if (s.starts_with("0x") || s.starts_with("0X")) { s.remove_prefix(2); radix = 16; }
+    uint32_t value = 0;
+    const auto parsed = std::from_chars(s.data(), s.data()+s.size(), value, radix);
+    return !s.empty() && parsed.ec == std::errc{} && parsed.ptr == s.data()+s.size() &&
+        value && value <= 0x02000000u-sizeof(uint32_t) ? value : 0;
+}
+}
diff --git a/ps2xRuntime/include/ps2_presentation_policy.h b/ps2xRuntime/include/ps2_presentation_policy.h
new file mode 100644
index 0000000..0162550
--- /dev/null
+++ b/ps2xRuntime/include/ps2_presentation_policy.h
@@ -0,0 +1,31 @@
+#pragma once
+
+namespace ps2host
+{
+enum class PresentationPhase { Start, End };
+
+// EE-thread-owned host submission policy. It never alters guest IRQs or cycles.
+// Movie begin/end changes after Start affect the next field, not this field.
+class FieldPresentation
+{
+    PresentationPhase phase = PresentationPhase::Start;
+    bool movie = false;
+    bool pendingEnd = false;
+public:
+    void configure(PresentationPhase value) { phase = value; }
+    void setMovieActive(bool active) { movie = active; }
+    void reset() { phase = PresentationPhase::Start; movie = pendingEnd = false; }
+    void restartFieldState() { movie = pendingEnd = false; } // run restarts retain post-load configuration
+    bool atStart()
+    {
+        pendingEnd = phase == PresentationPhase::End && !movie;
+        return !pendingEnd;
+    }
+    bool atEnd()
+    {
+        const bool present = pendingEnd;
+        pendingEnd = false;
+        return present;
+    }
+};
+}

diff --git a/ps2xRuntime/src/lib/dod_host_pacer.cpp b/ps2xRuntime/src/lib/dod_host_pacer.cpp
new file mode 100644
index 0000000..660af6f
--- /dev/null
+++ b/ps2xRuntime/src/lib/dod_host_pacer.cpp
@@ -0,0 +1,52 @@
+#include "dod_host_pacer.h"
+#ifdef _WIN32
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#include <Windows.h>
+#endif
+
+dodhost::Pacer::Pacer()
+{
+#ifdef _WIN32
+    if (enabled)
+    {
+        timer = CreateWaitableTimerExW(nullptr, nullptr, 0x00000002,
+                                       TIMER_MODIFY_STATE | SYNCHRONIZE);
+        highResolution = timer != nullptr;
+        if (!timer)
+            timer = CreateWaitableTimerExW(nullptr, nullptr, 0,
+                                           TIMER_MODIFY_STATE | SYNCHRONIZE);
+    }
+#endif
+}
+dodhost::Pacer::~Pacer()
+{
+#ifdef _WIN32
+    if (timer) CloseHandle(timer);
+#endif
+}
+void dodhost::Pacer::wait()
+{
+    if (!enabled) return;
+    const auto target = schedule.advance(Clock::now());
+#ifdef _WIN32
+    const auto margin = highResolution ? std::chrono::microseconds(100)
+                                       : std::chrono::microseconds(1000);
+    const auto remaining = target - Clock::now() - margin;
+    if (remaining > Clock::duration::zero())
+    {
+        LARGE_INTEGER due;
+        due.QuadPart = -std::max<LONGLONG>(1,
+            std::chrono::duration_cast<std::chrono::nanoseconds>(remaining).count() / 100);
+        if (timer && SetWaitableTimer(timer, &due, 0, nullptr, nullptr, FALSE))
+            WaitForSingleObject(timer, INFINITE);
+        else
+            std::this_thread::sleep_until(target - margin);
+    }
+    while (Clock::now() < target) YieldProcessor();
+#else
+    std::this_thread::sleep_until(target - std::chrono::milliseconds(1));
+    while (Clock::now() < target) std::this_thread::yield();
+#endif
+}
diff --git a/ps2xRuntime/src/lib/dod_input_settings.h b/ps2xRuntime/src/lib/dod_input_settings.h
new file mode 100644
index 0000000..b2b0cc2
--- /dev/null
+++ b/ps2xRuntime/src/lib/dod_input_settings.h
@@ -0,0 +1,165 @@
+#pragma once
+
+// DoD runner/private host-input contract. Codes match raylib KeyboardKey;
+// this header deliberately does not depend on the runtime's public headers.
+#include <array>
+#include <cerrno>
+#include <cctype>
+#include <cstdint>
+#include <cstdlib>
+#include <limits>
+#include <map>
+#include <string>
+
+namespace dod_input
+{
+    struct KeyboardBinding
+    {
+        uint16_t button;
+        std::array<int, 2> keys;
+    };
+    using KeyboardBindings = std::array<KeyboardBinding, 16>;
+    inline constexpr std::array<const char *, 16> settingNames = {
+        "key_up", "key_down", "key_left", "key_right", "key_cross", "key_circle",
+        "key_square", "key_triangle", "key_l1", "key_r1", "key_l2", "key_r2",
+        "key_start", "key_select", "key_l3", "key_r3"};
+
+    inline KeyboardBindings defaults()
+    {
+        return {{{0x0010u, {265, 87}}, {0x0040u, {264, 83}},
+                 {0x0080u, {263, 65}}, {0x0020u, {262, 68}},
+                 {0x4000u, {88, 32}}, {0x2000u, {67, 256}},
+                 {0x8000u, {90, 320}}, {0x1000u, {86, 321}},
+                 {0x0400u, {81, 0}}, {0x0800u, {69, 0}},
+                 {0x0100u, {340, 0}}, {0x0200u, {344, 0}},
+                 {0x0008u, {257, 0}}, {0x0001u, {258, 0}},
+                 {0x0002u, {0, 0}}, {0x0004u, {0, 0}}}};
+    }
+
+    inline bool supportedKey(int key)
+    {
+        if (key == 0 || key == 32 || (key >= 48 && key <= 57) ||
+            (key >= 65 && key <= 90) || (key >= 256 && key <= 269) ||
+            (key >= 280 && key <= 284) || (key >= 290 && key <= 301) ||
+            (key >= 320 && key <= 336) || (key >= 340 && key <= 348)) return true;
+        switch (key)
+        {
+        case 39: case 44: case 45: case 46: case 47: case 59: case 61:
+        case 91: case 92: case 93: case 96: return true;
+        default: return false;
+        }
+    }
+
+    inline bool integer(const std::string &text, int &value)
+    {
+        const char *start = text.c_str();
+        char *end = nullptr;
+        errno = 0;
+        const long parsed = std::strtol(start, &end, 10);
+        if (start == end || errno == ERANGE || parsed < std::numeric_limits<int>::min() ||
+            parsed > std::numeric_limits<int>::max()) return false;
+        while (*end && std::isspace(static_cast<unsigned char>(*end))) ++end;
+        if (*end) return false;
+        value = static_cast<int>(parsed);
+        return true;
+    }
+
+    inline bool parsePair(const std::string &text, std::array<int, 2> &keys)
+    {
+        keys = {0, 0};
+        const size_t comma = text.find(',');
+        if (comma != std::string::npos && text.find(',', comma + 1) != std::string::npos) return false;
+        if (!integer(text.substr(0, comma), keys[0]) || !supportedKey(keys[0])) return false;
+        return comma == std::string::npos ||
+            (integer(text.substr(comma + 1), keys[1]) && supportedKey(keys[1]));
+    }
+
+    // A malformed or ambiguous keyboard profile falls back as a whole, so a
+    // partial override cannot silently steal a key from another PS2 button.
+    inline bool load(const std::map<std::string, std::string> &ini,
+                     KeyboardBindings &bindings, std::string &error)
+    {
+        KeyboardBindings candidate = defaults();
+        bindings = defaults();
+        error.clear();
+        std::map<int, size_t> owners;
+        for (size_t i = 0; i < candidate.size(); ++i)
+        {
+            const auto found = ini.find(settingNames[i]);
+            if (found != ini.end() && !parsePair(found->second, candidate[i].keys))
+            {
+                error = std::string(settingNames[i]) + " must contain one or two supported key codes (0 disables a slot)";
+                return false;
+            }
+            for (int key : candidate[i].keys)
+            {
+                if (key == 0) continue;
+                const auto previous = owners.find(key);
+                if (previous != owners.end() && previous->second != i)
+                {
+                    error = std::string("key ") + std::to_string(key) + " conflicts between " +
+                        settingNames[previous->second] + " and " + settingNames[i];
+                    return false;
+                }
+                owners[key] = i;
+            }
+        }
+        bindings = candidate;
+        return true;
+    }
+
+    // [DoD] Keyboard keys for the analog sticks (dod.ini key_lstick_up ... key_rstick_right, one or two keys each,
+    // none by default): a held key pushes that stick fully in its direction. A key already used by a button, or a
+    // malformed entry, drops only that stick direction, never the button profile.
+    using StickBindings = std::array<std::array<int, 2>, 8>; // L up, down, left, right; R up, down, left, right
+    inline constexpr std::array<const char *, 8> stickSettingNames = {
+        "key_lstick_up", "key_lstick_down", "key_lstick_left", "key_lstick_right",
+        "key_rstick_up", "key_rstick_down", "key_rstick_left", "key_rstick_right"};
+
+    inline StickBindings loadSticks(const std::map<std::string, std::string> &ini, const KeyboardBindings &buttons,
+                                    std::string &error)
+    {
+        StickBindings sticks{};
+        error.clear();
+        std::map<int, std::string> owners;
+        for (const KeyboardBinding &binding : buttons)
+            for (int key : binding.keys)
+                if (key != 0) owners[key] = "a button";
+        for (size_t i = 0; i < sticks.size(); ++i)
+        {
+            const auto found = ini.find(stickSettingNames[i]);
+            std::array<int, 2> keys{};
+            if (found == ini.end()) continue;
+            if (!parsePair(found->second, keys))
+            {
+                error += std::string(stickSettingNames[i]) + " ignored (one or two supported key codes); ";
+                continue;
+            }
+            bool clash = false;
+            for (int key : keys)
+                if (key != 0 && owners.count(key))
+                {
+                    error += std::string(stickSettingNames[i]) + " ignored: key " + std::to_string(key) + " already used by " +
+                        owners[key] + "; ";
+                    clash = true;
+                }
+            if (clash) continue;
+            for (int key : keys)
+                if (key != 0) owners[key] = stickSettingNames[i];
+            sticks[i] = keys;
+        }
+        return sticks;
+    }
+
+    inline bool windowSize(const std::string &text, int &width, int &height)
+    {
+        const size_t split = text.find_first_of("xX");
+        if (split == std::string::npos || !integer(text.substr(0, split), width) ||
+            !integer(text.substr(split + 1), height)) return false;
+        return width > 0 && height > 0 && width <= 16384 && height <= 16384;
+    }
+}
+
+// Startup only: call before runtime.initialize()/the first window-thread poll.
+void dodConfigureKeyboardInput(const dod_input::KeyboardBindings &bindings);
+void dodConfigureKeyboardSticks(const dod_input::StickBindings &sticks);
diff --git a/ps2xRuntime/src/lib/dod_mpeg_dma_ingress.h b/ps2xRuntime/src/lib/dod_mpeg_dma_ingress.h
new file mode 100644
index 0000000..4966223
--- /dev/null
+++ b/ps2xRuntime/src/lib/dod_mpeg_dma_ingress.h
@@ -0,0 +1,111 @@
+#pragma once
+// Private DoD native CH4 -> HLE MPEG ownership bridge. No guest state or callbacks.
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+#include <deque>
+#include <mutex>
+#include <vector>
+
+namespace dod_mpeg_dma
+{
+    inline constexpr size_t kCapacityBytes = 2u * 1024u * 1024u;
+    struct Session
+    {
+        uint32_t mpegAddr = 0;
+        uint64_t generation = 0;
+        explicit operator bool() const { return mpegAddr != 0; }
+    };
+    enum class SubmitResult { Accepted, Backpressure, Stale, Invalid, TooLarge };
+
+    class Ingress
+    {
+    public:
+        explicit Ingress(size_t capacity = kCapacityBytes) : capacity_(capacity) {}
+        Session begin(uint32_t mpegAddr)
+        {
+            std::lock_guard<std::mutex> lock(mutex_);
+            clearLocked(); session_.mpegAddr = mpegAddr; ++session_.generation;
+            return session_;
+        }
+        void end(uint32_t mpegAddr)
+        {
+            std::lock_guard<std::mutex> lock(mutex_);
+            if (session_.mpegAddr == mpegAddr)
+            { clearLocked(); session_.mpegAddr = 0; ++session_.generation; }
+        }
+        void endAll()
+        {
+            std::lock_guard<std::mutex> lock(mutex_);
+            clearLocked(); session_.mpegAddr = 0; ++session_.generation;
+        }
+        void reset(uint32_t mpegAddr)
+        {
+            std::lock_guard<std::mutex> lock(mutex_);
+            if (session_.mpegAddr == mpegAddr && mpegAddr != 0)
+            { clearLocked(); ++session_.generation; }
+        }
+        Session activeSession() const
+        { std::lock_guard<std::mutex> lock(mutex_); return session_; }
+        size_t queuedBytes(uint32_t mpegAddr) const
+        {
+            std::lock_guard<std::mutex> lock(mutex_);
+            return session_.mpegAddr == mpegAddr && mpegAddr != 0 ? queued_ : 0;
+        }
+        // Success transfers the complete byte vector. On every other result the
+        // caller still owns all bytes, and no byte or queue state has changed.
+        SubmitResult submit(Session expected, std::vector<uint8_t> &bytes)
+        {
+            std::lock_guard<std::mutex> lock(mutex_);
+            if (!expected || expected.mpegAddr != session_.mpegAddr || expected.generation != session_.generation)
+                return SubmitResult::Stale;
+            if ((bytes.size() & 15u) != 0u) return SubmitResult::Invalid;
+            if (bytes.size() > capacity_) return SubmitResult::TooLarge;
+            if (bytes.size() > capacity_ - queued_) return SubmitResult::Backpressure;
+            if (!bytes.empty())
+            {
+                const size_t count = bytes.size();
+                chunks_.push_back(std::move(bytes)); queued_ += count;
+            }
+            return SubmitResult::Accepted;
+        }
+        // MPEG owns the returned bytes. Partial takes preserve the exact suffix
+        // and order; taking input never calls the decoder or resumes guest code.
+        std::vector<uint8_t> take(uint32_t mpegAddr, size_t maxBytes = 64u * 1024u)
+        {
+            std::lock_guard<std::mutex> lock(mutex_);
+            std::vector<uint8_t> result;
+            if (mpegAddr == 0 || session_.mpegAddr != mpegAddr || maxBytes == 0) return result;
+            const size_t count = std::min(maxBytes, queued_);
+            result.reserve(count);
+            while (result.size() < count)
+            {
+                const auto &front = chunks_.front();
+                const size_t part = std::min(count - result.size(), front.size() - frontOffset_);
+                result.insert(result.end(), front.begin() + static_cast<std::ptrdiff_t>(frontOffset_),
+                              front.begin() + static_cast<std::ptrdiff_t>(frontOffset_ + part));
+                frontOffset_ += part;
+                if (frontOffset_ == front.size()) { chunks_.pop_front(); frontOffset_ = 0; }
+            }
+            queued_ -= count;
+            return result;
+        }
+    private:
+        void clearLocked() { chunks_.clear(); frontOffset_ = 0; queued_ = 0; }
+        mutable std::mutex mutex_;
+        const size_t capacity_;
+        Session session_;
+        std::deque<std::vector<uint8_t>> chunks_;
+        size_t frontOffset_ = 0, queued_ = 0;
+    };
+
+    inline Ingress &ingress() { static Ingress value; return value; }
+    inline Session begin(uint32_t mpegAddr) { return ingress().begin(mpegAddr); }
+    inline void reset(uint32_t mpegAddr) { ingress().reset(mpegAddr); }
+    inline void end(uint32_t mpegAddr) { ingress().end(mpegAddr); }
+    inline void endAll() { ingress().endAll(); }
+    inline Session activeSession() { return ingress().activeSession(); }
+    inline size_t queuedBytes(uint32_t mpegAddr) { return ingress().queuedBytes(mpegAddr); }
+    inline std::vector<uint8_t> take(uint32_t mpegAddr, size_t maxBytes = 64u * 1024u)
+    { return ingress().take(mpegAddr, maxBytes); }
+}
diff --git a/ps2xRuntime/src/lib/dod_to_ipu_dma.h b/ps2xRuntime/src/lib/dod_to_ipu_dma.h
new file mode 100644
index 0000000..abc374f
--- /dev/null
+++ b/ps2xRuntime/src/lib/dod_to_ipu_dma.h
@@ -0,0 +1,154 @@
+#pragma once
+// Private, independently testable CH4 gather/commit transaction. Caller is the
+// EE memory thread; this layer never invokes a decoder, scheduler, or GS callback.
+#include "dod_mpeg_dma_ingress.h"
+#include <cstring>
+#include <limits>
+#include <stdexcept>
+
+namespace dod_mpeg_dma
+{
+    struct Registers
+    {
+        uint32_t madr = 0, qwc = 0, tadr = 0, asr0 = 0, asr1 = 0;
+    };
+    template<class Io> Registers readRegisters(const Io &io)
+    {
+        auto read = [&](uint32_t address)
+        { const auto found = io.find(address); return found == io.end() ? 0u : found->second; };
+        return {read(0x1000B410u), read(0x1000B420u), read(0x1000B430u),
+                read(0x1000B440u), read(0x1000B450u)};
+    }
+    template<class Io> void commitRegisters(Io &io, const Registers &value)
+    {
+        io[0x1000B410u] = value.madr; io[0x1000B420u] = value.qwc;
+        io[0x1000B430u] = value.tadr; io[0x1000B440u] = value.asr0; io[0x1000B450u] = value.asr1;
+    }
+    struct Gathered
+    {
+        Registers final;
+        std::vector<uint8_t> bytes;
+        uint32_t completedChcr = 0;
+    };
+    // Same tag traversal and address rules as the original dodGatherToIpu.
+    // Only a successful return owns a complete transaction; the source registers
+    // are never mutated while gathering or when the bounded active path rejects.
+    template<class Resolve, class Advance>
+    Gathered gather(Registers initial, uint32_t chcr, Resolve resolve, Advance advance,
+                    size_t limit = std::numeric_limits<size_t>::max(), bool trackIpuChainState = false)
+    {
+        Gathered result; result.final = initial; result.completedChcr = chcr;
+        auto append = [&](uint32_t address, uint32_t qwc)
+        {
+            const size_t count = static_cast<size_t>(qwc) * 16u;
+            if (count > limit - result.bytes.size()) throw std::length_error("toIPU transaction exceeds staging bound");
+            for (uint32_t i = 0; i < qwc; ++i)
+            {
+                const uint8_t *p = resolve(address);
+                result.bytes.insert(result.bytes.end(), p, p + 16);
+                address = advance(address, 16u);
+            }
+            return address;
+        };
+        result.final.madr = append(initial.madr, initial.qwc & 0xFFFFu);
+        result.final.qwc = 0;
+        if (((chcr >> 2) & 3u) != 1u) return result;
+        uint32_t tadr = initial.tadr, asr[2] = {initial.asr0, initial.asr1};
+        uint32_t asp = (chcr >> 4) & 3u;
+        const bool tie = (chcr & 0x80u) != 0u;
+        if (trackIpuChainState && (initial.qwc & 0xFFFFu) != 0u)
+        {
+            // Native stop/restart resumes the already-fetched tag's remainder.
+            // Its CHCR.TAG still determines CNT TADR progress and whether another
+            // tag may be fetched after this QWC finishes (REFE/END/TIE+IRQ stop).
+            const uint32_t previousId = (chcr >> 28) & 7u;
+            if (previousId == 1u) result.final.tadr = tadr = result.final.madr;
+            if (previousId == 0u || previousId == 7u || (tie && (chcr & 0x80000000u))) return result;
+        }
+        for (int tags = 0; tags < 65536; ++tags)
+        {
+            uint64_t tag = 0; std::memcpy(&tag, resolve(tadr), sizeof(tag));
+            const uint32_t qwc = static_cast<uint32_t>(tag & 0xFFFFu);
+            const uint32_t id = static_cast<uint32_t>((tag >> 28) & 7u);
+            const bool irq = ((tag >> 31) & 1u) != 0u;
+            const uint32_t addr = static_cast<uint32_t>(tag >> 32);
+            bool end = false;
+            if (trackIpuChainState)
+            {
+                // CH4 uses the non-stack source-chain semantics: every tag's
+                // upper half is reflected in CHCR, and MADR is the address just
+                // past its actual payload. ASP/ASR are not a CH4 call stack.
+                result.completedChcr = (chcr & 0xFFFFu) | (static_cast<uint32_t>(tag) & 0xFFFF0000u);
+                uint32_t source = addr;
+                switch (id)
+                {
+                case 0: tadr += 16u; end = true; break;
+                case 1: source = tadr + 16u; break;
+                case 2: source = tadr + 16u; tadr = addr; break;
+                case 3: case 4: tadr += 16u; break;
+                case 7: source = tadr + 16u; end = true; break;
+                default: end = true; break; // Undefined CH4 CALL/RET: no stack traversal.
+                }
+                result.final.madr = append(source, qwc);
+                if (id == 1u) tadr = result.final.madr;
+                if (end || (irq && tie)) break;
+                continue;
+            }
+            switch (id)
+            {
+            case 0: append(addr, qwc); tadr += 16u; end = true; break;
+            case 1: tadr = append(tadr + 16u, qwc); break;
+            case 2: append(tadr + 16u, qwc); tadr = addr; break;
+            case 3: case 4: append(addr, qwc); tadr += 16u; break;
+            case 5:
+            {
+                const uint32_t ret = append(tadr + 16u, qwc);
+                if (asp < 2u) asr[asp++] = ret;
+                tadr = addr; break;
+            }
+            case 6:
+                append(tadr + 16u, qwc);
+                if (asp > 0u) tadr = asr[--asp]; else end = true;
+                break;
+            default: append(tadr + 16u, qwc); end = true; break;
+            }
+            if (end || (irq && tie)) break;
+        }
+        result.final.tadr = tadr; result.final.asr0 = asr[0]; result.final.asr1 = asr[1];
+        return result;
+    }
+
+    class PendingTransfer
+    {
+    public:
+        bool active() const { return active_; }
+        bool oversized() const { return oversized_; }
+        Session session() const { return session_; }
+        size_t bytes() const { return transfer_.bytes.size(); }
+        template<class Resolve, class Advance>
+        void stage(Session session, Registers registers, uint32_t chcr, Resolve resolve, Advance advance)
+        {
+            if (active_) return; // retries cannot recapture or duplicate a packet
+            active_ = true; session_ = session;
+            try { transfer_ = gather(registers, chcr, resolve, advance, kCapacityBytes, true); }
+            catch (const std::length_error &) { oversized_ = true; transfer_ = {}; }
+        }
+        // Exactly the acceptance point commits MADR/QWC/tag registers. The
+        // PS2Memory owner then clears STR and raises the existing DMAC cause.
+        template<class Io> SubmitResult service(Ingress &target, Io &io)
+        {
+            if (!active_) return SubmitResult::Invalid;
+            if (oversized_) return SubmitResult::TooLarge;
+            const SubmitResult result = target.submit(session_, transfer_.bytes);
+            if (result == SubmitResult::Accepted)
+            { commitRegisters(io, transfer_.final); io[0x1000B400u] = transfer_.completedChcr; abort(); }
+            return result;
+        }
+        // Hardware stop/reset only: no register progress, completion, or EOS.
+        void abort() { active_ = false; oversized_ = false; session_ = {}; transfer_ = {}; }
+    private:
+        bool active_ = false, oversized_ = false;
+        Session session_;
+        Gathered transfer_;
+    };
+}
diff --git a/ps2xRuntime/src/lib/dod_vif1_unpack.h b/ps2xRuntime/src/lib/dod_vif1_unpack.h
new file mode 100644
index 0000000..ee09388
--- /dev/null
+++ b/ps2xRuntime/src/lib/dod_vif1_unpack.h
@@ -0,0 +1,180 @@
+#pragma once
+// [DoD] VIF1 UNPACK specialised per format (RUNTIME_PATCHES row 121). Same semantics as the per-element version in
+// ps2_vif1_interpreter.cpp (PCSX2 Vif_Unpack.cpp via KillzoneRecomp patch 0010), but VN/VL, the mask bit and STMOD
+// are template parameters, so the per-element format switch, the mask lookups and the mode switch compile away.
+// vif1UnpackPcsx2 was 6.4% of the EE thread in room 0x386. Checked against the per-element version by
+// tools/scripts/diag/vif1_unpack_diff (random commands, registers and data, byte-exact VU memory and registers).
+// Regs is any struct with cycle, mode, num, mask, tops, row[4], col[4] (VIFRegisters, or the test's copy).
+#include <array>
+#include <cstdint>
+#include <cstring>
+#include <utility>
+
+namespace dod_vif1_unpack
+{
+    // Bytes of source data per vector, by VN<<2|VL (PCSX2 nVifT).
+    constexpr uint8_t kGsize[16] = {4, 2, 1, 0, 8, 4, 2, 0, 12, 6, 3, 0, 16, 8, 4, 2};
+
+    template <class Regs, uint32_t VNVL, bool MASK, uint32_t MODE>
+    void unpack(uint8_t *vuMem, uint32_t vuMemSize, Regs &regs, uint32_t cmd, const uint8_t *data, uint32_t dataBytes)
+    {
+        constexpr uint32_t vsize = kGsize[VNVL];
+        if constexpr (vsize == 0u)
+        {
+            (void)vuMem, (void)vuMemSize, (void)regs, (void)cmd, (void)data, (void)dataBytes;
+            return; // invalid unpack (PCSX2 only warns)
+        }
+        else
+        {
+            constexpr uint32_t vn = VNVL >> 2;
+            const bool usn = (cmd & 0x4000u) != 0u;
+            uint32_t num = (cmd >> 16) & 0xFFu;
+            if (num == 0u)
+                num = 256u;
+            const uint32_t cl = regs.cycle & 0xFFu;
+            const uint32_t wl = ((regs.cycle >> 8) & 0xFFu) ? ((regs.cycle >> 8) & 0xFFu) : 256u;
+            const bool isFill = cl < wl;
+            uint32_t addr = cmd & 0x3FFu;
+            if ((cmd & 0x8000u) != 0u)
+                addr += regs.tops;
+            addr = (addr << 4) & 0x3FF0u;
+            const uint32_t skipBytes = isFill ? 0u : (cl - wl) * 16u;
+            const uint32_t memMask = vuMemSize - 16u;
+
+            auto element = [&](uint32_t offset, uint32_t index) -> uint32_t
+            {
+                const uint32_t at = offset + index * (4u >> (VNVL & 3u));
+                if (at + (4u >> (VNVL & 3u)) > dataBytes)
+                    return 0u;
+                if constexpr ((VNVL & 3u) == 0u)
+                {
+                    uint32_t v;
+                    std::memcpy(&v, data + at, 4);
+                    return v;
+                }
+                else if constexpr ((VNVL & 3u) == 1u)
+                {
+                    uint16_t v;
+                    std::memcpy(&v, data + at, 2);
+                    return usn ? static_cast<uint32_t>(v) : static_cast<uint32_t>(static_cast<int32_t>(static_cast<int16_t>(v)));
+                }
+                else
+                {
+                    const uint8_t v = data[at];
+                    return usn ? static_cast<uint32_t>(v) : static_cast<uint32_t>(static_cast<int32_t>(static_cast<int8_t>(v)));
+                }
+            };
+
+            auto write = [&](uint32_t *dest, uint32_t f, uint32_t value)
+            {
+                if constexpr (MODE == 1u)
+                    dest[f] = value + regs.row[f];
+                else if constexpr (MODE == 2u)
+                {
+                    regs.row[f] += value;
+                    dest[f] = regs.row[f];
+                }
+                else if constexpr (MODE == 3u)
+                {
+                    regs.row[f] = value;
+                    dest[f] = value;
+                }
+                else
+                    dest[f] = value;
+            };
+
+            uint32_t src = 0u; // byte offset of the current source vector
+            uint32_t vcl = 0u; // write-cycle counter (PCSX2 vif.cl)
+            for (uint32_t n = 0; n < num; ++n)
+            {
+                uint32_t in[4];
+                if constexpr (VNVL == 15u)
+                {
+                    uint16_t v = 0;
+                    if (src + 2u <= dataBytes)
+                        std::memcpy(&v, data + src, 2);
+                    in[0] = (v & 0x001Fu) << 3;
+                    in[1] = (v & 0x03E0u) >> 2;
+                    in[2] = (v & 0x7C00u) >> 7;
+                    in[3] = (v & 0x8000u) >> 8;
+                }
+                else if constexpr (vn == 0u)
+                {
+                    in[0] = in[1] = in[2] = in[3] = element(src, 0);
+                }
+                else if constexpr (vn == 1u)
+                {
+                    in[0] = in[2] = element(src, 0);
+                    in[1] = in[3] = element(src, 1);
+                }
+                else // V3 and V4 read four elements
+                {
+                    for (uint32_t c = 0; c < 4u; ++c)
+                        in[c] = element(src, c);
+                }
+
+                uint32_t *dest = reinterpret_cast<uint32_t *>(vuMem + (addr & memMask));
+                if constexpr (!MASK)
+                {
+                    for (uint32_t f = 0; f < 4u; ++f)
+                        write(dest, f, in[f]);
+                }
+                else
+                {
+                    const uint32_t maskCycle = vcl < 3u ? vcl : 3u;
+                    for (uint32_t f = 0; f < 4u; ++f)
+                    {
+                        switch ((regs.mask >> (maskCycle * 8u + f * 2u)) & 3u)
+                        {
+                        case 0: write(dest, f, in[f]); break;
+                        case 1: dest[f] = regs.row[f]; break;
+                        case 2: dest[f] = regs.col[maskCycle]; break;
+                        default: break; // write protect
+                        }
+                    }
+                }
+
+                addr += 16u;
+                ++vcl;
+                if (isFill)
+                {
+                    if (vcl <= cl)
+                        src += vsize;
+                    else if (vcl == wl)
+                        vcl = 0u;
+                }
+                else
+                {
+                    src += vsize;
+                    if (vcl >= wl)
+                    {
+                        addr += skipBytes;
+                        vcl = 0u;
+                    }
+                }
+            }
+            regs.num = 0u;
+        }
+    }
+
+    template <class Regs>
+    using UnpackFn = void (*)(uint8_t *, uint32_t, Regs &, uint32_t, const uint8_t *, uint32_t);
+
+    // Index: VN<<5 | VL<<3 | mask bit<<2 | STMOD.
+    template <class Regs, size_t... K>
+    constexpr std::array<UnpackFn<Regs>, sizeof...(K)> makeTable(std::index_sequence<K...>)
+    {
+        return {{&unpack<Regs, static_cast<uint32_t>(K >> 3), ((K >> 2) & 1u) != 0u, static_cast<uint32_t>(K & 3u)>...}};
+    }
+
+    template <class Regs>
+    void unpackDispatch(uint8_t *vuMem, uint32_t vuMemSize, Regs &regs, uint32_t cmd, const uint8_t *data,
+                        uint32_t dataBytes)
+    {
+        static constexpr auto table = makeTable<Regs>(std::make_index_sequence<128>{});
+        const uint32_t upk = (cmd >> 24) & 0x1Fu;
+        const uint32_t vnvl = upk & 0xFu;
+        const uint32_t mode = (vnvl == 15u) ? 0u : (regs.mode & 3u); // V4-5 ignores STMOD
+        table[(vnvl << 3) | (((upk >> 4) & 1u) << 2) | mode](vuMem, vuMemSize, regs, cmd, data, dataBytes);
+    }
+}
diff --git a/ps2xRuntime/src/lib/gs/dod_cg_cadence.h b/ps2xRuntime/src/lib/gs/dod_cg_cadence.h
new file mode 100644
index 0000000..441c8c7
--- /dev/null
+++ b/ps2xRuntime/src/lib/gs/dod_cg_cadence.h
@@ -0,0 +1,225 @@
+#pragma once
+
+// Progressive story-CG cadence, on the GS thread. The native player submits
+// each decoded frame every two fields, but its deferred uploads can arrive
+// either side of a field boundary. Select the existing completed buffer on
+// that two-field cadence instead of exposing a 3/1-field pair.
+// DOD_CG_CADENCE=keep restores the native display selection.
+// DOD_CG_GS_TRACE=<first field>:<count> observes uploads without GPU readback.
+namespace dodpcsx2::cgtrace
+{
+inline bool cadenceOn()
+{
+    static const bool on = [] {
+        const char* v = std::getenv("DOD_CG_CADENCE");
+        return !(v && std::strcmp(v, "keep") == 0);
+    }();
+    return on;
+}
+struct Path
+{
+    unsigned left = 0, flag = 0, nreg = 1, index = 0;
+    uint64_t regs = 0;
+};
+struct State
+{
+    uint64_t first = 0, end = 0, field = 0;
+    Path paths[4];
+    uint64_t bitblt = 0, trxpos = 0, trxreg = 0;
+    unsigned bytes = 0, y = 0, xbytes = 0, slot = 0;
+    bool movieRow = false;
+    uint64_t rolling[2]{}, hash[2]{}, updates[2]{};
+    unsigned nextRow[2]{};
+    bool active = false, seenFrame = false, valid[2]{}, heldValid = false;
+    uint32_t decoderFrame = 0, stable = 0, phase = 0, newestSlot = 0;
+    uint64_t submittedField = 0, newFrameField = 0, completed[2]{}, held = 0;
+    uint64_t corrections = 0, unavailable = 0;
+};
+inline State state = [] {
+    State s;
+    if (const char* v = std::getenv("DOD_CG_GS_TRACE"))
+    {
+        char* tail = nullptr;
+        s.first = std::strtoull(v, &tail, 10);
+        if (tail && *tail == ':')
+            s.end = s.first + std::min<uint64_t>(72000, std::strtoull(tail + 1, nullptr, 10)); // up to 20 min: whole movies
+    }
+    return s;
+}();
+
+inline void submitted(uint32_t frame, uint64_t queued, bool eligible)
+{
+    auto& s = state;
+    if (!cadenceOn()) eligible = false;
+    if (!eligible || !s.active || (s.seenFrame && frame < s.decoderFrame))
+    {
+        s.active = eligible;
+        s.seenFrame = false;
+        s.stable = 0;
+        s.valid[0] = s.valid[1] = s.heldValid = false;
+        s.nextRow[0] = s.nextRow[1] = 0;
+        s.movieRow = false;
+    }
+    if (!eligible) return;
+    s.submittedField = queued;
+    if (!s.seenFrame || frame != s.decoderFrame)
+    {
+        const bool regular = s.seenFrame && frame == s.decoderFrame + 1 &&
+                             queued == s.newFrameField + 2;
+        s.stable = regular ? std::min(s.stable + 1, 8u) : 0;
+        if (!regular) s.heldValid = false;
+        s.phase = static_cast<unsigned>((queued + 1) & 1);
+        s.newFrameField = queued;
+        s.decoderFrame = frame;
+        s.seenFrame = true;
+    }
+}
+
+inline void write(unsigned addr, uint64_t value)
+{
+    auto& s = state;
+    if (addr == 0x50) s.bitblt = value;
+    if (addr == 0x51) s.trxpos = value;
+    if (addr == 0x52) s.trxreg = value;
+    if (addr != 0x53) return;
+    const unsigned bp = (s.bitblt >> 32) & 0x3fff;
+    const unsigned bw = (s.bitblt >> 48) & 0x3f;
+    const unsigned psm = (s.bitblt >> 56) & 0x3f;
+    const unsigned w = s.trxreg & 0xfff, h = (s.trxreg >> 32) & 0xfff;
+    s.y = (s.trxpos >> 48) & 0x7ff;
+    s.xbytes = 0;
+    s.bytes = w * h * 4;
+    s.slot = bp == 0 ? 0 : 1;
+    s.movieRow = (s.active || (s.end && s.field < s.end)) &&
+                 (value & 3) == 0 && (bp == 0 || bp == 0x800) && bw == 8 && psm == 0 &&
+                 w >= 512 && w <= 640 && h == 1 && s.y >= 24 && s.y < 192 &&
+                 ((s.trxpos >> 32) & 0x7ff) == 0;
+    if (s.movieRow && s.y == 24)
+    {
+        s.rolling[s.slot] = 14695981039346656037ull;
+        s.nextRow[s.slot] = 24;
+    }
+    if (s.movieRow && s.nextRow[s.slot] != s.y)
+        s.movieRow = false;
+}
+
+inline void gif(unsigned path, const uint8_t* data, unsigned bytes)
+{
+    auto& s = state;
+    if (!cadenceOn() && (!s.end || s.field >= s.end)) return;
+    auto& p = s.paths[path & 3];
+    for (unsigned pos = 0; pos + 16 <= bytes; pos += 16)
+    {
+        uint64_t lo, hi;
+        std::memcpy(&lo, data + pos, 8);
+        std::memcpy(&hi, data + pos + 8, 8);
+        if (!p.left)
+        {
+            p.flag = (lo >> 58) & 3;
+            p.nreg = (lo >> 60) & 15;
+            if (!p.nreg) p.nreg = 16;
+            const unsigned n = lo & 0x7fff;
+            p.left = p.flag == 0 ? n * p.nreg : p.flag == 1 ? (n * p.nreg + 1) / 2 : n;
+            p.index = 0;
+            p.regs = hi;
+            continue;
+        }
+        if (p.flag == 0)
+        {
+            if (((p.regs >> (4 * (p.index % p.nreg))) & 15) == 14)
+                write(hi & 0xff, lo);
+            ++p.index;
+        }
+        else if (p.flag == 2)
+        {
+            if (s.movieRow)
+            {
+                // Two RGB samples per 32 pixels; ignore padding past width 512.
+                if (s.xbytes < 2048 && (s.xbytes & 127) == 0)
+                {
+                    s.rolling[s.slot] = (s.rolling[s.slot] ^ (lo & 0xffffff)) * 1099511628211ull;
+                    s.rolling[s.slot] = (s.rolling[s.slot] ^ (hi & 0xffffff)) * 1099511628211ull;
+                }
+                // The movie overrides TRXREG.RRW with 640 but sends only
+                // the 512 source pixels before starting the next row.
+                if (s.xbytes + 16 >= 2048)
+                {
+                    s.nextRow[s.slot] = s.y + 1;
+                    if (s.y == 191)
+                    {
+                        s.hash[s.slot] = s.rolling[s.slot];
+                        ++s.updates[s.slot];
+                        s.completed[s.slot] = s.field + 1;
+                        s.newestSlot = s.slot;
+                        s.valid[s.slot] = s.active;
+                        if (s.end && s.field + 1 >= s.first && s.field + 1 < s.end)
+                            std::fprintf(stderr, "[cg-upload] field %llu bp %X hash %016llX update %llu\n",
+                                         s.field + 1, s.slot ? 0x800 : 0, s.hash[s.slot], s.updates[s.slot]);
+                    }
+                    s.movieRow = false;
+                }
+            }
+            s.xbytes += 16;
+        }
+        --p.left;
+        // Bulk skip image/REGLIST payloads when no sampled row is in progress.
+        // Keep tag continuation across calls even outside a story CG.
+        if (p.flag != 0 && !s.movieRow)
+        {
+            const unsigned skip = std::min(p.left, (bytes - pos - 16) / 16);
+            pos += skip * 16;
+            p.left -= skip;
+            if (p.flag == 2) s.xbytes += skip * 16;
+        }
+    }
+}
+
+inline void select(uint64_t field, Pcsx2GsPrivRegs& priv)
+{
+    auto& s = state;
+    const uint64_t fb = priv.regset1[9];
+    if (!s.active || s.stable < 8 || field > s.submittedField + 4 ||
+        (priv.regset1[0] & 3) != 2 || (fb != 0x1000 && fb != 0x1040) ||
+        !s.valid[s.newestSlot] || field > s.completed[s.newestSlot] + 2)
+    {
+        s.heldValid = false;
+        return;
+    }
+    if (!s.heldValid || (field & 1) == s.phase)
+    {
+        s.held = s.hash[s.newestSlot];
+        s.heldValid = true;
+    }
+    const unsigned original = fb == 0x1040 ? 1 : 0;
+    unsigned selected = original;
+    if (!s.valid[selected] || s.hash[selected] != s.held)
+    {
+        selected ^= 1;
+        if (!s.valid[selected] || s.hash[selected] != s.held)
+        {
+            ++s.unavailable;
+            s.heldValid = false;
+            return; // no invented frame or replay of an overwritten buffer
+        }
+    }
+    if (selected != original)
+    {
+        priv.regset1[9] = (fb & ~0x1ffull) | (selected ? 0x40 : 0);
+        ++s.corrections;
+    }
+}
+
+inline void vsync(uint64_t field, const Pcsx2GsPrivRegs& priv, double presentMs)
+{
+    auto& s = state;
+    s.field = field;
+    if (!s.end || field < s.first || field >= s.end) return;
+    const auto now = std::chrono::steady_clock::now();
+    static const auto start = now;
+    const double ms = std::chrono::duration<double, std::milli>(now - start).count();
+    std::fprintf(stderr, "[cg-gs] field %llu fb1 %llX fb2 %llX pmode %llX h0 %016llX h1 %016llX u0 %llu u1 %llu ms %.3f present %.3f active %u stable %u phase %u corrections %llu unavailable %llu\n",
+                 field, priv.regset1[7], priv.regset1[9], priv.regset1[0],
+                 s.hash[0], s.hash[1], s.updates[0], s.updates[1], ms, presentMs,
+                 unsigned(s.active), s.stable, s.phase, s.corrections, s.unavailable);
+}
+}

diff --git a/ps2xRuntime/src/lib/dod_audio_settings.h b/ps2xRuntime/src/lib/dod_audio_settings.h
new file mode 100644
index 0000000..4e8432c
--- /dev/null
+++ b/ps2xRuntime/src/lib/dod_audio_settings.h
@@ -0,0 +1,23 @@
+#pragma once
+#include <cerrno>
+#include <climits>
+#include <cctype>
+#include <cstdlib>
+#include <string>
+
+namespace dod_audio
+{
+    // Same integer-percent contract as the launcher: absent/malformed = 100,
+    // valid integers clamp to 0..100. This private header does not reach generated code.
+    inline int percent(const std::string &value)
+    {
+        char *end = nullptr;
+        errno = 0;
+        const long parsed = std::strtol(value.c_str(), &end, 10);
+        if (end == value.c_str() || errno == ERANGE || parsed < INT_MIN || parsed > INT_MAX)
+            return 100;
+        while (*end && std::isspace(static_cast<unsigned char>(*end))) ++end;
+        if (*end) return 100;
+        return parsed < 0 ? 0 : parsed > 100 ? 100 : static_cast<int>(parsed);
+    }
+}
diff --git a/ps2xRuntime/src/lib/dod_cheats.cpp b/ps2xRuntime/src/lib/dod_cheats.cpp
new file mode 100644
index 0000000..378ecfd
--- /dev/null
+++ b/ps2xRuntime/src/lib/dod_cheats.cpp
@@ -0,0 +1,237 @@
+// [DoD] In-game cheat menu (F2): the user's Action Replay codes for Shin Onimusha: Dawn of Dreams (SLPM-66275),
+// decrypted with the AR1 key (work/cheats-20261028/ar_decrypt.py, decrypted.txt). Fourteen of them rewrite game
+// instructions (a branch made a no-op or redirected, an add / load replaced); the recompiled functions do not read their
+// instructions from RAM, so those are switches inside the generated code (g_dodCheats, added by
+// tools/scripts/apply_dod_cheats.py at exactly those instructions; off = the original code). The item counts are RAM
+// writes once per host frame, as an emulator applies a code. Everything starts off at each launch.
+// The panel is the GS's ImGui menu (pcsx2gs_api.h set_menu): docked at the left, scaled with the image height, mouse
+// read from Win32 in image pixels (dodpcsx2::menuInput), keyboard / controller navigation; the game gets a released pad
+// while it is open.
+#include "dod_cheats.h"
+
+#include "gs/dod_pcsx2_gs.h"
+#include "gs/pcsx2gs_api.h"
+#include "ps2_host_backend.h"
+
+#include <atomic>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+
+extern "C" volatile unsigned char g_dodCheats[32] = {};
+
+namespace
+{
+    struct Entry
+    {
+        int id;             // -1: a section title
+        const char *label;  // UTF-8 (Simplified Chinese, as the game's text)
+        const char *help;   // hover / focus help (may be null)
+        const char *note;   // shown under the item (warnings)
+    };
+
+    const Entry kEntries[] = {
+        {-1, "一闪", nullptr, nullptr},
+        {kDodCheatChainCount, "连锁一闪次数无限制", "连锁一闪不再有次数上限。", nullptr},
+        {kDodCheatChainRange, "连锁一闪：不限敌人距离",
+         "连锁一闪可以接到任意距离的敌人。原作者建议搭配“一闪距离变更”（设为 100）使用，本菜单没有该项。", nullptr},
+        {kDodCheatChainSameEnemy, "连锁一闪：可重复攻击同一敌人", "在幻魔空间里可能会碍事。", nullptr},
+        {kDodCheatOtherIssenRange, "其他一闪：不限敌人距离", "通常一闪以外的一闪也能接到任意距离的敌人。", nullptr},
+        {kDodCheatBassari, "一闪爽快感辅助", "原作者的“バッサリ感”辅助：建议与上面四项一起开启。", nullptr},
+        {kDodCheatDeflectIssen, "R1 锁定后攻击即为弹一闪", "按住 R1 锁定敌人，再按攻击就是弹一闪。", nullptr},
+        {-1, "能力槽", nullptr, nullptr},
+        {kDodCheatSpirit, "心力常时回复", "心力一直回满。", nullptr},
+        {kDodCheatOniPower, "鬼力常时回复", "鬼战术用完立刻回满。", nullptr},
+        {kDodCheatOugi, "奥义随时可用", "奥义槽一直是满的。", nullptr},
+        {-1, "道具与强化", nullptr, nullptr},
+        {kDodCheatItems, "道具数量保持 99（前 10 格）", "已有道具的数量一直是 99；空格不会变出道具。", nullptr},
+        {kDodCheatMoneyMax, "金钱变动时直接最大", "得到或花掉金钱时，金钱直接变为最大值。", nullptr},
+        {kDodCheatKibushiMax, "鬼武侠点数变动时直接最大", "鬼武侠点数变动时直接变为最大值。", nullptr},
+        {kDodCheatSoulsKeep, "强化武器时不消耗魂", "强化武器时，分配出去的魂不会减少。", nullptr},
+        {kDodCheatUpgradeOnce, "武具强化：分配一次魂就升级", "武具强化时，分配一次魂就升一级。", nullptr},
+        {kDodCheatSkill99, "技强化获得点数 99", "技强化时得到的点数固定为 99。", "原作者注明可能会黑屏，开启前请先存档。"},
+    };
+
+    std::atomic<bool> s_open{false};        // F2 / Esc on the window thread, the close button on the GS thread
+    std::atomic<bool> s_justOpened{false};  // the next drawn frame gives the panel the focus
+    std::atomic<uint16_t> s_hostButtons{0xFFFFu};
+    std::atomic<bool> s_hostGamepad{false};
+
+    const char *labelOf(int id)
+    {
+        for (const Entry &e : kEntries)
+            if (e.id == id)
+                return e.label;
+        return "?";
+    }
+
+    void setCheat(int id, bool on)
+    {
+        if (id < 0 || id >= static_cast<int>(kDodCheatCount) || (g_dodCheats[id] != 0) == on)
+            return;
+        g_dodCheats[id] = on ? 1u : 0u;
+        std::fprintf(stderr, "[cheats] %s: %s\n", labelOf(id), on ? "on" : "off");
+    }
+
+    // GS thread, at every present while the menu is shown.
+    void drawMenu(const Pcsx2GsUi *ui, void *)
+    {
+        int open = 1;
+        const char *title = "金手指###dodcheats";
+        const uint32_t flags = PCSX2GS_PANEL_LEFT | (s_justOpened.exchange(false) ? PCSX2GS_PANEL_FOCUS : 0u);
+        const bool panel = ui->version >= 3u && ui->begin_panel;
+        const int visible = panel ? ui->begin_panel(title, &open, 440.0f, 860.0f, flags) : ui->begin_window(title, &open, 440.0f, 860.0f);
+        if (visible)
+        {
+            ui->text_disabled("F2 或 Esc 关闭");
+            ui->text_disabled("鼠标／方向键＋空格／手柄十字键＋A");
+            for (const Entry &e : kEntries)
+            {
+                if (e.id < 0)
+                {
+                    ui->separator_text(e.label);
+                    continue;
+                }
+                ui->push_id(e.id);
+                int value = g_dodCheats[e.id] ? 1 : 0;
+                if (ui->checkbox(e.label, &value))
+                    setCheat(e.id, value != 0);
+                if (panel && ui->tooltip && e.help)
+                    ui->tooltip(e.help);
+                if (e.note)
+                    ui->text_colored(0xFF4A8CF5u, e.note); // orange (R in the low byte)
+                ui->pop_id();
+            }
+            ui->spacing();
+            if (ui->button("全部关闭"))
+                for (int id = 0; id < static_cast<int>(kDodCheatCount); ++id)
+                    setCheat(id, false);
+            ui->text_wrapped("只在这次运行有效；重新启动游戏后全部恢复关闭。");
+        }
+        ui->end_window();
+        if (!open)
+            s_open.store(false, std::memory_order_relaxed);
+    }
+
+    // DOD_CHEATS=all | <index>,<index>... (tests): switches on at start; DOD_CHEAT_MENU_AT=<seconds>: opens the menu then.
+    void applyTestEnv()
+    {
+        const char *v = std::getenv("DOD_CHEATS");
+        if (!v || !*v)
+            return;
+        if (std::strcmp(v, "all") == 0)
+        {
+            for (int id = 0; id < static_cast<int>(kDodCheatCount); ++id)
+                setCheat(id, true);
+            return;
+        }
+        for (const char *p = v; *p;)
+        {
+            char *end = nullptr;
+            const long id = std::strtol(p, &end, 10);
+            if (end == p)
+                break;
+            setCheat(static_cast<int>(id), true);
+            p = *end == ',' ? end + 1 : end;
+        }
+    }
+
+    uint32_t menuKeys()
+    {
+        uint32_t keys = 0u;
+        const auto key = [&](int raylibKey, uint32_t bit) {
+            if (IsKeyDown(raylibKey))
+                keys |= bit;
+        };
+        key(KEY_UP, PCSX2GS_KEY_UP);
+        key(KEY_DOWN, PCSX2GS_KEY_DOWN);
+        key(KEY_LEFT, PCSX2GS_KEY_LEFT);
+        key(KEY_RIGHT, PCSX2GS_KEY_RIGHT);
+        key(KEY_ENTER, PCSX2GS_KEY_ENTER);
+        key(KEY_KP_ENTER, PCSX2GS_KEY_ENTER);
+        key(KEY_SPACE, PCSX2GS_KEY_SPACE);
+        key(KEY_ESCAPE, PCSX2GS_KEY_ESCAPE);
+        key(KEY_TAB, PCSX2GS_KEY_TAB);
+        key(KEY_LEFT_SHIFT, PCSX2GS_KEY_SHIFT);
+        key(KEY_RIGHT_SHIFT, PCSX2GS_KEY_SHIFT);
+        key(KEY_LEFT_CONTROL, PCSX2GS_KEY_CTRL);
+        key(KEY_RIGHT_CONTROL, PCSX2GS_KEY_CTRL);
+        return keys;
+    }
+
+    // The controller's buttons (only when it is the active device: the keyboard's own mapping to pad buttons would
+    // move the cursor twice) as the menu's: D-pad, A / cross = accept, B / circle = back, L1 / R1.
+    uint32_t menuPad()
+    {
+        if (!s_hostGamepad.load(std::memory_order_relaxed))
+            return 0u;
+        const uint16_t held = static_cast<uint16_t>(~s_hostButtons.load(std::memory_order_relaxed));
+        uint32_t pad = 0u;
+        if (held & 0x0010u) pad |= PCSX2GS_PAD_UP;
+        if (held & 0x0040u) pad |= PCSX2GS_PAD_DOWN;
+        if (held & 0x0080u) pad |= PCSX2GS_PAD_LEFT;
+        if (held & 0x0020u) pad |= PCSX2GS_PAD_RIGHT;
+        if (held & 0x4000u) pad |= PCSX2GS_PAD_ACCEPT;
+        if (held & 0x2000u) pad |= PCSX2GS_PAD_BACK;
+        if (held & 0x0400u) pad |= PCSX2GS_PAD_L1;
+        if (held & 0x0800u) pad |= PCSX2GS_PAD_R1;
+        return pad;
+    }
+}
+
+void dodCheatsSetHostPad(uint16_t buttons, bool gamepad)
+{
+    s_hostButtons.store(buttons, std::memory_order_relaxed);
+    s_hostGamepad.store(gamepad, std::memory_order_relaxed);
+}
+
+bool dodCheatsMenuOpen()
+{
+    return s_open.load(std::memory_order_relaxed);
+}
+
+void dodCheatsHostTick(uint8_t *rdram)
+{
+    static bool started = false;
+    static bool shown = false;
+    static double menuAt = []() { const char *v = std::getenv("DOD_CHEAT_MENU_AT"); return v ? std::atof(v) : 0.0; }();
+    if (!started)
+    {
+        started = true;
+        applyTestEnv();
+    }
+    const bool autoOpen = menuAt > 0.0 && GetTime() >= menuAt;
+    if (autoOpen)
+        menuAt = 0.0;
+    if (IsKeyPressed(KEY_F2) || autoOpen)
+    {
+        const bool open = autoOpen || !s_open.load(std::memory_order_relaxed);
+        s_open.store(open, std::memory_order_relaxed);
+        if (open)
+            s_justOpened.store(true, std::memory_order_relaxed);
+    }
+    else if (shown && IsKeyPressed(KEY_ESCAPE))
+        s_open.store(false, std::memory_order_relaxed);
+
+    const bool open = s_open.load(std::memory_order_relaxed);
+    if (open != shown)
+    {
+        dodpcsx2::setMenu(open ? drawMenu : nullptr, nullptr);
+        if (!open)
+            dodpcsx2::menuInput(0u, 0u, 0.0f); // nothing held when it opens again
+        shown = open;
+        std::fprintf(stderr, "[cheats] menu %s\n", open ? "open" : "closed");
+    }
+    if (open)
+        dodpcsx2::menuInput(menuKeys(), menuPad(), GetMouseWheelMove());
+
+    // RAM codes: the first ten item slots' counts (8-bit at 0x8D729C + 8 n; the code writes 0xC7 into all ten, this
+    // keeps the 99 its title says and leaves empty slots empty).
+    if (rdram && g_dodCheats[kDodCheatItems])
+        for (uint32_t n = 0; n < 10u; ++n)
+        {
+            uint8_t &count = rdram[0x8D729Cu + 8u * n];
+            if (count != 0u && count != 99u)
+                count = 99u;
+        }
+}
diff --git a/ps2xRuntime/src/lib/dod_cheats.h b/ps2xRuntime/src/lib/dod_cheats.h
new file mode 100644
index 0000000..da1e9ca
--- /dev/null
+++ b/ps2xRuntime/src/lib/dod_cheats.h
@@ -0,0 +1,37 @@
+#pragma once
+
+#include <cstdint>
+
+// [DoD] In-game cheat menu (F2, dod_cheats.cpp). The switches are read by the generated functions themselves
+// (tools/scripts/apply_dod_cheats.py adds `g_dodCheats[n]` at the patched instructions), so the indexes below are fixed:
+// the script uses the same numbers.
+enum DodCheat : unsigned
+{
+    kDodCheatChainCount = 0,      // 2B3D50 2B3E80: chain Issen without a count limit
+    kDodCheatChainRange = 1,      // 2B26FC: chain Issen finds enemies at any distance
+    kDodCheatChainSameEnemy = 2,  // 2B26B4: chain Issen may hit the same enemy again
+    kDodCheatOtherIssenRange = 3, // 26010C 260190 26029C: the other Issen kinds find enemies at any distance
+    kDodCheatBassari = 4,         // 2B3694: the "slash feel" helper (the chain counter does not count up)
+    kDodCheatDeflectIssen = 5,    // 26005C: lock on (R1), then an attack is a deflect Issen
+    kDodCheatSpirit = 6,          // 25F14C: spirit gauge always refills
+    kDodCheatOniPower = 7,        // 25F114: Oni power refills at once
+    kDodCheatOugi = 8,            // 25F2C8: ougi gauge always full
+    kDodCheatItems = 9,           // RAM 0x8D729C + 8 n (n < 10): item counts held at 99
+    kDodCheatMoneyMax = 10,       // 2F22C8 2F231C: money goes to the maximum when it changes
+    kDodCheatKibushiMax = 11,     // 3345B4: Kibushi points go to the maximum when they change
+    kDodCheatSoulsKeep = 12,      // 362AF8: upgrading weapons does not use souls
+    kDodCheatUpgradeOnce = 13,    // 362B0C: one soul allotment levels a weapon / armour up
+    kDodCheatSkill99 = 14,        // 329940: skill upgrades give 99 points (the code's author: may black out)
+    kDodCheatCount = 15,
+};
+
+extern "C" volatile unsigned char g_dodCheats[32];
+
+// Window thread, once per host frame after the pad poll: F2 opens / closes the menu, its input goes to the GS while it
+// is open, the RAM cheats are written. rdram = the guest's 32 MB.
+void dodCheatsHostTick(uint8_t *rdram);
+// While the menu is open the game gets a released pad (ps2_pad.cpp).
+bool dodCheatsMenuOpen();
+// The pad buttons the host read this frame (active low, PS2 order) and whether they came from a controller: the
+// menu's controller navigation (ps2_pad.cpp publishes them before it blanks the game's copy).
+void dodCheatsSetHostPad(uint16_t buttons, bool gamepad);
diff --git a/ps2xRuntime/src/lib/dod_gamepad.cpp b/ps2xRuntime/src/lib/dod_gamepad.cpp
new file mode 100644
index 0000000..12c2d71
--- /dev/null
+++ b/ps2xRuntime/src/lib/dod_gamepad.cpp
@@ -0,0 +1,185 @@
+#include "dod_gamepad.h"
+#include <atomic>
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <string>
+
+#if defined(_WIN32)
+#define WIN32_LEAN_AND_MEAN
+#define NOMINMAX
+#include <windows.h>
+#define SDL_MAIN_HANDLED
+#include "../../../../SDL2-2.30.9/include/SDL.h"
+
+namespace {
+// Reuse the shipped SDL 2.30.9. Loading is optional so a missing dependency
+// cannot prevent keyboard input or the existing raylib fallback from booting.
+struct Api {
+    HMODULE dll = nullptr;
+#define API(name) decltype(&SDL_##name) name = nullptr
+    API(SetHint); API(InitSubSystem); API(QuitSubSystem); API(GetVersion);
+    API(GetError); API(PumpEvents); API(NumJoysticks); API(IsGameController);
+    API(GameControllerOpen); API(GameControllerClose); API(GameControllerUpdate);
+    API(GameControllerGetAttached); API(GameControllerGetButton); API(GameControllerGetAxis);
+    API(GameControllerName); API(GameControllerRumble); API(GameControllerHasRumble);
+    API(GameControllerEventState); API(JoystickEventState);
+#undef API
+} api;
+SDL_GameController *pad = nullptr;
+bool attempted = false, ready = false, enabled = true, rumbleAvailable = false;
+bool failureLogged = false;
+uint64_t nextScan = 0, lastOutput = 0;
+uint16_t lastMotors = 0;
+std::atomic<uint64_t> request{0}; // monotonic milliseconds : large : small
+uint64_t nowMs() {
+    return static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::milliseconds>(
+        std::chrono::steady_clock::now().time_since_epoch()).count());
+}
+bool initialize() {
+    if (attempted) return ready;
+    attempted = true;
+    wchar_t filename[32768];
+    const DWORD n = GetModuleFileNameW(nullptr, filename, 32768);
+    if (!n || n >= 32768) return false;
+    const std::wstring exe(filename, n);
+    const auto slash = exe.find_last_of(L"\\/");
+    if (slash == std::wstring::npos) return false;
+    api.dll = LoadLibraryW((exe.substr(0, slash + 1) + L"SDL2.dll").c_str());
+    if (!api.dll) {
+        std::fprintf(stderr, "[gamepad] SDL2.dll unavailable; raylib/keyboard fallback\n");
+        return false;
+    }
+#define LOAD(name) api.name = reinterpret_cast<decltype(api.name)>(GetProcAddress(api.dll, "SDL_" #name)); if (!api.name) return false
+    LOAD(SetHint); LOAD(InitSubSystem); LOAD(QuitSubSystem); LOAD(GetVersion);
+    LOAD(GetError); LOAD(PumpEvents); LOAD(NumJoysticks); LOAD(IsGameController);
+    LOAD(GameControllerOpen); LOAD(GameControllerClose); LOAD(GameControllerUpdate);
+    LOAD(GameControllerGetAttached); LOAD(GameControllerGetButton); LOAD(GameControllerGetAxis);
+    LOAD(GameControllerName); LOAD(GameControllerRumble); LOAD(GameControllerHasRumble);
+    LOAD(GameControllerEventState); LOAD(JoystickEventState);
+#undef LOAD
+    SDL_version version{}; api.GetVersion(&version);
+    if (version.major != 2 || SDL_VERSIONNUM(version.major, version.minor, version.patch) < SDL_VERSIONNUM(2, 0, 18)) {
+        std::fprintf(stderr, "[gamepad] SDL 2.0.18+ required; using fallback\n");
+        return false;
+    }
+    api.SetHint(SDL_HINT_JOYSTICK_HIDAPI, "1");
+    api.SetHint(SDL_HINT_JOYSTICK_HIDAPI_PS4, "1");
+    api.SetHint(SDL_HINT_JOYSTICK_HIDAPI_PS5, "1");
+    // Sony Bluetooth needs enhanced reports for motor output (also used by Oni3).
+    api.SetHint(SDL_HINT_JOYSTICK_HIDAPI_PS4_RUMBLE, enabled ? "1" : "0");
+    api.SetHint(SDL_HINT_JOYSTICK_HIDAPI_PS5_RUMBLE, enabled ? "1" : "0");
+    // SDL has no window here (raylib owns it). Focus is gated explicitly below.
+    api.SetHint(SDL_HINT_JOYSTICK_ALLOW_BACKGROUND_EVENTS, "1");
+    if (api.InitSubSystem(SDL_INIT_GAMECONTROLLER) != 0) {
+        std::fprintf(stderr, "[gamepad] SDL init failed: %s\n", api.GetError());
+        return false;
+    }
+    api.GameControllerEventState(SDL_IGNORE);
+    api.JoystickEventState(SDL_IGNORE);
+    ready = true;
+    std::fprintf(stderr, "[gamepad] SDL %u.%u.%u ready; rumble=%d; controllers=%d\n",
+                 version.major, version.minor, version.patch, enabled, api.NumJoysticks());
+    return true;
+}
+void closePad() {
+    if (pad) {
+        if (rumbleAvailable) api.GameControllerRumble(pad, 0, 0, 0);
+        api.GameControllerClose(pad);
+        pad = nullptr;
+    }
+    request.store(0, std::memory_order_release);
+    lastMotors = 0; lastOutput = 0; rumbleAvailable = false;
+}
+void motors(bool focused, uint64_t now) {
+    const uint64_t r = request.load(std::memory_order_acquire);
+    const uint64_t published = r >> 16;
+    const uint64_t age = now >= published ? now - published : 0;
+    const uint16_t value = enabled && focused && r && age < 750 ? static_cast<uint16_t>(r) : 0;
+    if (!focused) request.store(0, std::memory_order_release);
+    if (!rumbleAvailable || (value == lastMotors && (!value || now - lastOutput < 100))) return;
+    // Large PS2 motor: variable low frequency. Small motor: binary high frequency.
+    const int result = api.GameControllerRumble(pad, static_cast<Uint16>((value >> 8) * 257u),
+                                               (value & 1u) ? 65535u : 0u, value ? 250u : 0u);
+    if (result != 0 && !failureLogged) {
+        failureLogged = true;
+        std::fprintf(stderr, "[gamepad] rumble failed: %s\n", api.GetError());
+    }
+    lastMotors = value; lastOutput = now;
+}
+}
+
+void dodConfigureGamepad(bool rumbleEnabled) { enabled = rumbleEnabled; }
+void dodRequestPadRumble(int port, uint8_t large, uint8_t small) {
+    if (port != 0) return;
+    request.store((nowMs() << 16) | (uint64_t(large) << 8) | (small & 1u), std::memory_order_release);
+    static const bool trace = std::getenv("DOD_PAD_TRACE") != nullptr;
+    static unsigned logged = 0;
+    static int previous = -1;
+    const int current = (int(large) << 8) | (small & 1u);
+    if (trace && current != previous && logged < 128) {
+        ++logged; previous = current;
+        std::fprintf(stderr, "[gamepad] guest motors large=%u small=%u\n", large, small & 1u);
+    }
+}
+bool dodGamepadBackendReady() { return ready; }
+bool dodPollGamepad(uint8_t *data, bool focused) {
+    if (!initialize()) return false;
+    api.PumpEvents();
+    api.GameControllerUpdate();
+    const uint64_t now = nowMs();
+    if (pad && !api.GameControllerGetAttached(pad)) {
+        std::fprintf(stderr, "[gamepad] disconnected\n");
+        closePad(); nextScan = 0;
+    }
+    if (!pad && now >= nextScan) {
+        nextScan = now + 500;
+        for (int i = 0, count = api.NumJoysticks(); i < count; ++i) {
+            if (!api.IsGameController(i)) continue;
+            pad = api.GameControllerOpen(i);
+            if (!pad) continue;
+            request.store(0, std::memory_order_release); // never replay old-device vibration
+            failureLogged = false;
+            rumbleAvailable = api.GameControllerHasRumble(pad) == SDL_TRUE;
+            std::fprintf(stderr, "[gamepad] connected: %s; rumble=%d\n", api.GameControllerName(pad), rumbleAvailable);
+            break;
+        }
+    }
+    if (!pad) return false;
+    motors(focused, now);
+    if (!focused) return true; // retain controller priority, publish neutral input
+    uint16_t buttons = 0xFFFFu;
+    const struct { SDL_GameControllerButton button; uint16_t mask; } bindings[] = {
+        {SDL_CONTROLLER_BUTTON_A,0x4000}, {SDL_CONTROLLER_BUTTON_B,0x2000},
+        {SDL_CONTROLLER_BUTTON_X,0x8000}, {SDL_CONTROLLER_BUTTON_Y,0x1000},
+        {SDL_CONTROLLER_BUTTON_BACK,1}, {SDL_CONTROLLER_BUTTON_START,8},
+        {SDL_CONTROLLER_BUTTON_LEFTSTICK,2}, {SDL_CONTROLLER_BUTTON_RIGHTSTICK,4},
+        {SDL_CONTROLLER_BUTTON_LEFTSHOULDER,0x400}, {SDL_CONTROLLER_BUTTON_RIGHTSHOULDER,0x800},
+        {SDL_CONTROLLER_BUTTON_DPAD_UP,0x10}, {SDL_CONTROLLER_BUTTON_DPAD_DOWN,0x40},
+        {SDL_CONTROLLER_BUTTON_DPAD_LEFT,0x80}, {SDL_CONTROLLER_BUTTON_DPAD_RIGHT,0x20}
+    };
+    for (const auto &b : bindings) if (api.GameControllerGetButton(pad, b.button)) buttons &= ~b.mask;
+    if (api.GameControllerGetAxis(pad, SDL_CONTROLLER_AXIS_TRIGGERLEFT) > 8192) buttons &= ~0x100u;
+    if (api.GameControllerGetAxis(pad, SDL_CONTROLLER_AXIS_TRIGGERRIGHT) > 8192) buttons &= ~0x200u;
+    data[2] = static_cast<uint8_t>(buttons); data[3] = static_cast<uint8_t>(buttons >> 8);
+    const SDL_GameControllerAxis axes[] = {SDL_CONTROLLER_AXIS_RIGHTX, SDL_CONTROLLER_AXIS_RIGHTY,
+                                          SDL_CONTROLLER_AXIS_LEFTX, SDL_CONTROLLER_AXIS_LEFTY};
+    for (int i = 0; i < 4; ++i) {
+        const int value = api.GameControllerGetAxis(pad, axes[i]);
+        data[4+i] = static_cast<uint8_t>((value + 32768) >> 8);
+    }
+    return true;
+}
+void dodShutdownGamepad() {
+    closePad();
+    if (ready) api.QuitSubSystem(SDL_INIT_GAMECONTROLLER);
+    ready = false;
+    if (api.dll) { FreeLibrary(api.dll); api.dll = nullptr; }
+}
+#else
+void dodConfigureGamepad(bool) {}
+void dodRequestPadRumble(int, uint8_t, uint8_t) {}
+bool dodPollGamepad(uint8_t *, bool) { return false; }
+bool dodGamepadBackendReady() { return false; }
+void dodShutdownGamepad() {}
+#endif
diff --git a/ps2xRuntime/src/lib/dod_gamepad.h b/ps2xRuntime/src/lib/dod_gamepad.h

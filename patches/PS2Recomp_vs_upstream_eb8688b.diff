+#define CTRL_IVF(c)  (((c) >> 21) & 1u)
+#define CTRL_QST(c)  (((c) >> 22) & 1u)
+#define CTRL_MP1(c)  (((c) >> 23) & 1u)
+#define CTRL_PCT(c)  (((c) >> 24) & 7u)

+        // [DoD] Upstream PR #347: IOP->EE SIF command packets handed to EE handlers. On hardware the EE copies each
+        // packet out of the kernel's receive buffer onto the interrupt handler's stack, so it never lives in title
+        // memory. guestMalloc's heap starts right after the ELF, which is where the game's own heap is. Each queued
+        // handler gets a slot in EE kernel RAM (0x78000-0x80000, below the interrupt stacks) until it returns.
+        constexpr uint32_t kSifCmdPacketBase = 0x00078000u;
+        constexpr uint32_t kSifCmdPacketSlotSize = 0x80u;

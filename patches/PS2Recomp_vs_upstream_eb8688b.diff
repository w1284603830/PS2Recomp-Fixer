+        if (g_renderer != "pcsx2")
+        {
+            std::fprintf(stderr, "[pcsx2-gs] renderer=%s: using the CPU raster\n", g_renderer.c_str());
+            return false;
+        }
+        const std::filesystem::path dll = exeDirectory() / "pcsx2gs.dll";
+        HMODULE module = LoadLibraryW(dll.c_str());
+        if (!module)
+        {

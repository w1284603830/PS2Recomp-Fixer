+/* IPU (MPEG decoder) emulation: commands BCLR/IDEC/BDEC/VDEC/FDEC/SETIQ/SETVQ/CSC/PACK/SETTH, the registers at
+ * 0x10002000-0x1000203C and the FIFOs, fed by the toIPU DMA and drained by fromIPU (ps2_memory.cpp).
+ * From the Ace Combat 5 static recompilation (https://github.com/sal063/Ace-Combat-5-Static-recompilation,
+ * runtime/src/ps2_ipu.c and ps2_ipu_dct.inc), Copyright its authors, Apache License 2.0 (compatible with this project's GPL-3.0; the license text is in
+ * docs/licenses/AC5-Recomp-APACHE-2.0.txt). Changes: the two includes replaced by ps2_ipu_compat.h. */
+#include "ps2_ipu_compat.h"
+#include <math.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define IPU_BCLR   0u
+#define IPU_IDEC   1u
+#define IPU_BDEC   2u
+#define IPU_VDEC   3u
+#define IPU_FDEC   4u
+#define IPU_SETIQ  5u
+#define IPU_SETVQ  6u
+#define IPU_CSC    7u
+#define IPU_PACK   8u
+#define IPU_SETTH  9u

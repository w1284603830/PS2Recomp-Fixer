diff --git a/ps2xRuntime/include/ps2_gs_pacing.h b/ps2xRuntime/include/ps2_gs_pacing.h
new file mode 100644
index 0000000..af1ef42
--- /dev/null
+++ b/ps2xRuntime/include/ps2_gs_pacing.h
@@ -0,0 +1,67 @@
+#pragma once
+
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <limits>
+
+// Host scheduling only: none of these helpers advances an EE/IOP/SPU clock.
+namespace ps2host
+{
+using Clock = std::chrono::steady_clock;
+
+inline uint32_t boundedUnsigned(const char* text, uint32_t maximum)
+{
+    if (!text || !*text)
+        return 0;
+    uint32_t value = 0;
+    for (const char* p = text; *p; ++p)
+    {
+        if (*p < '0' || *p > '9')
+            return 0;
+        const uint32_t digit = static_cast<uint32_t>(*p - '0');
+        if (digit > maximum || value > (maximum - digit) / 10u)
+            return 0;
+        value = value * 10u + digit;
+    }
+    return value;
+}
+
+class GsWaitTime
+{
+    std::atomic<uint64_t> nanoseconds{0};
+
+public:
+    // Producer thread only. An already-satisfied predicate contributes no time.
+    template <class ConditionVariable, class Lock, class Predicate>
+    void wait(ConditionVariable& cv, Lock& lock, Predicate pred)
+    {
+        if (pred())
+            return;
+        const auto start = Clock::now();
+        cv.wait(lock, pred);
+        const auto elapsed = std::chrono::duration_cast<std::chrono::nanoseconds>(Clock::now() - start).count();
+        if (elapsed > 0)
+            nanoseconds.fetch_add(static_cast<uint64_t>(elapsed), std::memory_order_relaxed);
+    }
+
+    uint64_t take() { return nanoseconds.exchange(0, std::memory_order_relaxed); }
+};
+
+// Preserve the guest deadline cycles/order. Saturate at the clock's maximum
+// rather than overflowing if a diagnostic supplies an extreme duration.
+template <class Deadlines>
+void shiftHostDeadlines(Deadlines& deadlines, uint64_t waitedNs, uint32_t drainUs)
+{
+    const uint64_t maximum = static_cast<uint64_t>(std::numeric_limits<int64_t>::max());
+    const uint64_t drainNs = static_cast<uint64_t>(drainUs) * 1000u;
+    const auto offset = std::chrono::duration_cast<Clock::duration>(std::chrono::nanoseconds(
+        static_cast<int64_t>(std::min(waitedNs, maximum - drainNs) + drainNs)));
+    for (auto& item : deadlines)
+    {
+        const auto latest = Clock::time_point::max() - offset;
+        item.hostDeadline = item.hostDeadline > latest ? Clock::time_point::max() : item.hostDeadline + offset;
+    }
+}
+}
diff --git a/ps2xRuntime/src/lib/Kernel/EeScheduler.cpp b/ps2xRuntime/src/lib/Kernel/EeScheduler.cpp
index b94002a..f0b7028 100644
--- a/ps2xRuntime/src/lib/Kernel/EeScheduler.cpp
+++ b/ps2xRuntime/src/lib/Kernel/EeScheduler.cpp
@@ -3,0 +4 @@
+#include "ps2_gs_pacing.h"
@@ -2588,0 +2590,42 @@ void EeScheduler::processPendingEvents()
+namespace
+{
+    // A blocked GS producer has advanced no guest cycles. Move the outstanding
+    // host deadlines by that measured wait, instead of treating it as guest debt.
+    // Extra queue draining is a port-specific tuning choice, disabled by default.
+    template <class Mutex, class Deadlines, class Update>
+    void forgiveGsWait(Mutex& mutex, Deadlines& deadlines, Update&& update, bool afterVsync = false)
+    {
+        static const bool legacy = []() {
+            const char* value = std::getenv("PS2_GS_WAIT_PACING");
+            return value && std::strcmp(value, "legacy") == 0;
+        }();
+        static const uint32_t drainUs = ps2host::boundedUnsigned(std::getenv("PS2_GS_DRAIN_US"), 2000u);
+        const uint64_t waited = dodpcsx2::takeGuestWaitNs();
+        const uint32_t inFlight = afterVsync ? dodpcsx2::fieldsInFlight() : 0u;
+        static const bool perf = std::getenv("DOD_PERF") != nullptr;
+        if (perf && (waited != 0u || afterVsync))
+        {
+            static thread_local uint64_t totalNs = 0u, waits = 0u, fields = 0u, depth = 0u;
+            static thread_local auto start = std::chrono::steady_clock::now();
+            totalNs += waited;
+            waits += waited != 0u;
+            if (afterVsync) { ++fields; depth += inFlight; }
+            const double seconds = std::chrono::duration<double>(std::chrono::steady_clock::now() - start).count();
+            if (seconds >= 5.0)
+            {
+                std::fprintf(stderr, "[perf:gs-wait] interval=%.3fs waits=%llu blocked_ms=%.1f depth_avg=%.2f pacing=%s drain_us=%u\n",
+                             seconds, static_cast<unsigned long long>(waits), totalNs / 1e6,
+                             fields ? static_cast<double>(depth) / fields : 0.0, legacy ? "legacy" : "compensate", drainUs);
+                totalNs = waits = fields = depth = 0u;
+                start = std::chrono::steady_clock::now();
+            }
+        }
+        const uint32_t drain = inFlight >= 2u ? drainUs : 0u;
+        if (legacy || (waited == 0u && drain == 0u))
+            return;
+        std::lock_guard lock(mutex);
+        ps2host::shiftHostDeadlines(deadlines, waited, drain);
+        update();
+    }
+}
+
